{% comment %}
  Set a new password from the emailed reset link.
  Header and footer come from the layout.
{% endcomment %}

{% style %}
  .commerce-account { display: flex; flex-direction: column; gap: 1.25rem; padding: 1.75rem; }
  .commerce-account .form-label { text-align: left; }
  .commerce-errors ul { list-style: disc; padding-left: 1.25rem; }
{% endstyle %}

<section class="banner" data-mount aria-labelledby="commerce-reset-title">
  <div class="banner-content">
    <h1 class="banner-title" id="commerce-reset-title">Reset password</h1>
    <p class="banner-subtitle">Choose a new password for your account.</p>
  </div>
</section>

<section class="section animate" aria-label="Reset password">
  <div class="container container--narrow" style="max-width: 520px;">
    <div class="glass-card commerce-account">
      {% form 'reset_customer_password' %}
        {%- if form.errors -%}
          <div class="status-message status-message--error commerce-errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div>
          <label class="form-label" for="commerce-reset-password">New password</label>
          <input class="form-input" type="password" id="commerce-reset-password" name="customer[password]"
                 autocomplete="new-password" required>
        </div>

        <div>
          <label class="form-label" for="commerce-reset-confirm">Confirm password</label>
          <input class="form-input" type="password" id="commerce-reset-confirm" name="customer[password_confirmation]"
                 autocomplete="new-password" required>
        </div>

        <div class="nice-button-box">
          <button type="submit" class="nice-button btn-md">Save new password</button>
        </div>
      {% endform %}
    </div>
  </div>
</section>
