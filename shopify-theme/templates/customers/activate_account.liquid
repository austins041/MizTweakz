{% comment %}
  Account activation from the emailed invite. The customer either sets a
  password or declines the invitation.
  Header and footer come from the layout.
{% endcomment %}

{% style %}
  .commerce-account { display: flex; flex-direction: column; gap: 1.25rem; padding: 1.75rem; }
  .commerce-account .form-label { text-align: left; }
  .commerce-errors ul { list-style: disc; padding-left: 1.25rem; }
  .commerce-activate-actions { display: flex; flex-wrap: wrap; gap: 12px; }
{% endstyle %}

<section class="banner" data-mount aria-labelledby="commerce-activate-title">
  <div class="banner-content">
    <h1 class="banner-title" id="commerce-activate-title">Activate account</h1>
    <p class="banner-subtitle">Set a password to finish creating your account.</p>
  </div>
</section>

<section class="section animate" aria-label="Activate account">
  <div class="container container--narrow" style="max-width: 520px;">
    <div class="glass-card commerce-account">
      {% form 'activate_customer_password' %}
        {%- if form.errors -%}
          <div class="status-message status-message--error commerce-errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div>
          <label class="form-label" for="commerce-activate-password">Password</label>
          <input class="form-input" type="password" id="commerce-activate-password" name="customer[password]"
                 autocomplete="new-password" required>
        </div>

        <div>
          <label class="form-label" for="commerce-activate-confirm">Confirm password</label>
          <input class="form-input" type="password" id="commerce-activate-confirm" name="customer[password_confirmation]"
                 autocomplete="new-password" required>
        </div>

        <div class="commerce-activate-actions">
          <div class="nice-button-box">
            <button type="submit" name="commit" class="nice-button btn-md">Activate account</button>
          </div>
          <div class="nice-button-box">
            <button type="submit" name="decline" class="nice-button grey btn-sm">Decline invitation</button>
          </div>
        </div>
      {% endform %}
    </div>
  </div>
</section>
