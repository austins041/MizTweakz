</section>

<!-- 9. FINAL CTA -->
<section class="final-cta glass-card reveal" aria-labelledby="cta-title">
  <div class="cta-glow" aria-hidden="true"></div>
  <span class="section-label"><span class="free-word">Free download</span></span>
  <h2 id="cta-title">Ready to optimize?</h2>
  <p>Grab the free app, follow the step-by-step guide and join 4,000+ players already running {{ shop.name }}.</p>
  <div class="cta-group">
    <div class="nice-button-box"><a class="nice-button btn-lg" href="{{ download_url }}">Download for <span class="free-word">Free</span></a></div>
  </div>
</section>

<script>
  (function () {
    var v = document.querySelector(".results-video");
    if (!v) return;
    /* With no MP4 configured the clip ships as an animated image, and an <img> has no
       play/pause/paused: calling them threw a TypeError on every scroll. The animated
       WebP loops on its own, so there is nothing to drive here. */
    if (v.tagName !== "VIDEO") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) { v.removeAttribute("autoplay"); v.controls = true; v.pause(); return; }
    /* mobile browsers may defer a muted autoplay that starts off-screen: (re)start the clip when it scrolls into view, pause it when it leaves */
    if (!("IntersectionObserver" in window)) return;
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
        else if (!v.paused) v.pause();
      });
    }, { threshold: 0.25 }).observe(v);
  })();
</script>

