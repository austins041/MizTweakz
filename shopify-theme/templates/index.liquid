{%- comment -%}
  Home page, ported from site/index.html.

  The <main class="page home-page"> wrapper and the skip link live in
  layout/theme.liquid, so this template emits sections only.

  Hooks assets/site.js still drives on this page:
    [data-mount]                 hero mount animation
    .reveal                      scroll reveal
    [data-marquee="brands"]      clones .brands-set twice for the game marquee
    [data-render="testimonials"] renders the review marquee from MZ.homeReviews
    [data-accordion]             FAQ accordion
    <i data-icon="name">         inline SVG icons
{%- endcomment -%}

{%- assign download_url = settings.download_url -%}
{%- assign about_page = pages['about'] -%}
{%- assign about_url = routes.root_url -%}
{%- if about_page.handle != blank -%}
  {%- assign about_url = about_page.url -%}
{%- endif -%}

<!-- 1. HERO -->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-inner" data-mount>
    <div class="logo-showcase">
      <picture>
        <source type="image/webp" srcset="{{ 'brand-logo.webp' | asset_url }}">
        <img class="logo-icon" src="{{ 'brand-logo.png' | asset_url }}" width="512" height="512" alt="{{ shop.name | escape }}" fetchpriority="high">
      </picture>
    </div>

    <div class="headline-block">
      <h1 class="hero-headline" id="hero-title">
        <span>Fix low FPS</span>
        <span class="accent">and input delay.</span>
      </h1>
      <p class="hero-tagline">525 tested Windows tweaks for a good PC that still feels slow. No new hardware, fully reversible.</p>
    </div>

    <div class="cta-group">
      <div class="nice-button-box"><a class="nice-button btn-lg" href="{{ download_url }}">Download for <span class="free-word">Free</span></a></div>
      <a class="nice-button grey btn-lg" href="{{ about_url }}">Learn More</a>
    </div>

    <p class="hero-description">
      Professional PC tweaks and Windows optimization that <span class="highlight">boost FPS</span>,
      <span class="highlight">cut input lag</span> and <span class="highlight">lower ping</span>,
      tested, non-intrusive and fully reversible.
    </p>

    <div class="stats-strip" aria-label="Key facts">
      <div class="stat-chip"><span class="stat-value">4.92&#9733;</span><span class="stat-divider" aria-hidden="true"></span><span class="stat-label">Avg. rating</span></div>
      <div class="stat-chip"><span class="stat-value">4,000+</span><span class="stat-divider" aria-hidden="true"></span><span class="stat-label">Active users</span></div>
      <div class="stat-chip"><span class="stat-value">Win 10 &amp; 11</span><span class="stat-divider" aria-hidden="true"></span><span class="stat-label">Fully reversible</span></div>
    </div>
  </div>
</section>

<!-- 3. GAME / BRAND MARQUEE -->
<section class="brands-section reveal" aria-label="Games our players compete in">
  <span class="brands-label">Trusted by players in</span>
  <div class="brands-marquee">
    <div class="brands-track" data-marquee="brands">
      <ul class="brands-set">
        <li class="brand-item"><img src="{{ 'games-fortnite.svg' | asset_url }}" width="158" height="44" alt="Fortnite" loading="lazy"></li>
        <li class="brand-item"><img src="{{ 'games-valorant.svg' | asset_url }}" width="95" height="64" alt="Valorant" loading="lazy"></li>
        <li class="brand-item"><img src="{{ 'games-apex.svg' | asset_url }}" width="90" height="60" alt="Apex Legends" loading="lazy"></li>
        <li class="brand-item"><img src="{{ 'games-cs2.svg' | asset_url }}" width="195" height="40" alt="Counter-Strike 2" loading="lazy"></li>
        <li class="brand-item"><img src="{{ 'games-warzone.webp' | asset_url }}" width="161" height="52" alt="Call of Duty: Warzone" loading="lazy"></li>
        <li class="brand-item"><img src="{{ 'games-rocket-league.svg' | asset_url }}" width="155" height="56" alt="Rocket League" loading="lazy"></li>
      </ul>
    </div>
  </div>
</section>

<!-- 5. BEFORE / AFTER -->
<section class="two-col two-col--media-wide reveal section" id="results" aria-labelledby="results-title">
  <div class="media-col">
    <div class="video-wrapper">
      {%- if settings.results_video_url != blank -%}
        <video class="results-video" width="1280" height="720" autoplay muted loop playsinline preload="metadata" poster="{{ 'finished-product-poster.webp' | asset_url }}" aria-label="Before and after gameplay comparison: 113 FPS with 5 ms input delay before, 367 FPS with 0 ms after">
          <source src="{{ settings.results_video_url }}" type="video/mp4">
          <img src="{{ 'finished-product.webp' | asset_url }}" width="1280" height="720" alt="Before and after gameplay comparison: 113 FPS with 5 ms input delay before, 367 FPS with 0 ms after" loading="lazy">
        </video>
      {%- else -%}
        <picture>
          <source media="(prefers-reduced-motion: reduce)" srcset="{{ 'finished-product-poster.webp' | asset_url }}">
          <img class="results-video" src="{{ 'finished-product.webp' | asset_url }}" width="1280" height="720" alt="Before and after gameplay comparison: 113 FPS with 5 ms input delay before, 367 FPS with 0 ms after" loading="lazy" decoding="async">
        </picture>
      {%- endif -%}
    </div>
  </div>
  <div class="text-col">
    <h2 class="section-title" id="results-title">Before and after, on the same PC</h2>
    <div class="feature-cards">
      <div class="feature-card"><i data-icon="gauge"></i><div><h3>Higher FPS</h3><p>Registry, power and GPU settings that unlock your hardware's true potential</p></div></div>
      <div class="feature-card"><i data-icon="stopwatch"></i><div><h3>Lower Input Delay</h3><p>Custom keyboard, mouse and controller tweaks so every input lands instantly</p></div></div>
      <div class="feature-card"><i data-icon="signal"></i><div><h3>Lower, Stable Ping</h3><p>Network registry tweaks for a steadier connection in every lobby</p></div></div>
    </div>
  </div>
</section>

<!-- 6. WHY MIZTWEAKZ -->
<section class="how-it-works reveal section" id="why" aria-labelledby="why-title">
  <div class="section-header">
    <h2 class="section-title" id="why-title">Tested, non-intrusive and fully reversible</h2>
    <p class="section-subtitle section-subtitle--plain">Everything is tested, non-intrusive and fully reversible. No sketchy third-party tools.</p>
  </div>
  <div class="steps-container">
    <article class="step-card glass-card" style="--delay:0s"><span class="step-icon"><i data-icon="shield"></i></span><h3>Tested</h3><p>Every tweak is tested on real hardware before being added to the app. No sketchy third-party tools. Just elite system tweaks used by Mizery himself, and some pros.</p></article>
    <article class="step-card glass-card" style="--delay:.15s"><span class="step-icon"><i data-icon="lock"></i></span><h3>Non-Intrusive</h3><p>Registry and settings changes only. Trusted by thousands of gamers.</p></article>
    <article class="step-card glass-card" style="--delay:.3s"><span class="step-icon"><i data-icon="undo"></i></span><h3>Fully Reversible</h3><p>Changed your mind? Every tweak includes a restore path so you can undo it in minutes.</p></article>
    <article class="step-card glass-card" style="--delay:.45s"><span class="step-icon"><i data-icon="book"></i></span><h3>Step-by-Step Guide</h3><p>Crystal-clear instructions with every tweak. No tech skills needed.</p></article>
    <article class="step-card glass-card" style="--delay:.6s"><span class="step-icon"><i data-icon="headset"></i></span><h3>Pro Support</h3><p>Stuck? Open a ticket in the Discord and get direct support from the team along the way.</p></article>
    <article class="step-card glass-card" style="--delay:.75s"><span class="step-icon"><i data-icon="download"></i></span><h3>Instant Delivery</h3><p>Download the app, sign in and your tweaks are ready to apply in minutes.</p></article>
  </div>
  <div class="cta-container">
    <div class="nice-button-box"><a class="nice-button btn-lg" href="{{ download_url }}">Download for <span class="free-word">Free</span></a></div>
    <p class="cta-note">Free app &middot; Windows 10 and 11 &middot; Step-by-step guide included</p>
  </div>
</section>

<!-- 6b. TRUSTED BY THE BEST -->
<section class="creators-section section reveal" id="creators" aria-labelledby="creators-title">
  <h2 class="section-title" id="creators-title">Trusted By The BEST</h2>
  <div class="creators-grid">
    <article class="creator-card glass-card"><img class="creator-avatar" src="{{ 'brand-creator-premfn-320.webp' | asset_url }}" width="320" height="320" alt="Premfn" loading="lazy"><h3 class="creator-name">Premfn</h3></article>
    <article class="creator-card glass-card"><img class="creator-avatar" src="{{ 'brand-creator-npen-320.webp' | asset_url }}" width="320" height="320" alt="Npen" loading="lazy"><h3 class="creator-name">Npen</h3></article>
    <article class="creator-card glass-card"><img class="creator-avatar" src="{{ 'brand-creator-aero1x-320.webp' | asset_url }}" width="320" height="320" alt="aero1x" loading="lazy"><h3 class="creator-name">aero1x</h3></article>
  </div>
  <div class="cta-group"><div class="nice-button-box"><a class="nice-button btn-lg" href="{{ download_url }}">Join 4,000+ Active Users</a></div></div>
</section>

<!-- 7. SOCIAL PROOF + TESTIMONIAL MARQUEE -->
<div class="reviews-carousel-group reveal">
  <section class="social-proof" aria-labelledby="proof-title">
    <h2 class="proof-title" id="proof-title">Customer Reviews</h2>
    <div class="proof-stars" role="img" aria-label="Rated 4.92 out of 5 stars"><span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
    <p class="proof-verified"><i data-icon="check" aria-hidden="true"></i> Verified Reviews</p>
    <div class="proof-line" aria-hidden="true"></div>
  </section>
  <div data-render="testimonials"></div>
</div>

