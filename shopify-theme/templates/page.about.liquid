{% comment %}
  About page. Ported from the static site/about/index.html: hero, story, values,
  verified reviews, benchmark videos, creators, closing CTA. Header and footer
  come from the layout; site.js still drives [data-mount], .animate / .reveal,
  the testimonial marquee and the consent gate on the YouTube embeds.
{% endcomment %}

{{ 'page-about.css' | asset_url | stylesheet_tag }}

  <!-- 1. HERO (Paragon .about-hero. Badge, "Who are we? / We are", logo, description, highlights) -->
  <section class="about-hero" aria-labelledby="about-title">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="about-hero-content" data-mount>
      <span class="hero-badge">About MIZTWEAKZ</span>
      <h1 class="hero-title" id="about-title">
        <span class="title-top">Who are we?</span>
        <span class="title-bottom">We are</span>
        <span class="sr-only">MIZTWEAKZ</span>
      </h1>
      <div class="logo-reveal">
        <picture>
          <source type="image/webp" srcset="{{ 'brand-logo.webp' | asset_url }}">
          <img src="{{ 'brand-logo.png' | asset_url }}" width="512" height="512" alt="MIZ TWEAKZ" fetchpriority="high">
        </picture>
      </div>
      <p class="hero-description">
        MIZTWEAKZ is the tweak shop built by experts for competitive players on any budget. Our packs are custom built PC
        optimizations that help improve FPS, reduce input lag, enhance responsiveness, and optimize Windows for better gaming
        performance. On everything from school laptops to high-end rigs. Everything is tested, non-intrusive, and fully
        reversible. No sketchy third-party tools. Just elite system tweaks used by Mizery himself, and some pros!
      </p>
    </div>
  </section>

  <!-- 2. STORY / MISSION (Paragon feature-section layout) -->
  <section class="two-col two-col--text-left section animate" id="story" aria-labelledby="story-title">
    <div class="text-col">
      <span class="section-label">Our Story</span>
      <h2 class="section-title" id="story-title">Performance Shouldn't Cost <span class="text-accent">A New PC.</span></h2>
      <p class="section-subtitle">built by experts. Used by pros.</p>
      <p class="section-description">
        Every MIZTWEAKZ pack is made of the same registry tweaks, power settings and network tweaks Mizery runs on his own
        setup. Packaged so anyone can apply them. <span class="highlight">The instructions and process are both crystal
        clear:</span> each tweak has a step-by-step guide and pro support in the Discord if you need
        help along the way. The store's own FAQ says real users have reported <span class="highlight">50 to 100 more FPS</span>, lower ping and a
        noticeable drop in input delay.
      </p>
    </div>
    <div class="media-col">
      <div class="video-wrapper">
        <img src="{{ 'brand-before-after.webp' | asset_url }}" srcset="{{ 'brand-before-after-640.webp' | asset_url }} 640w, {{ 'brand-before-after.webp' | asset_url }} 1280w" sizes="(max-width: 900px) 420px, 620px" width="1280" height="720" alt="Fortnite network stats before and after the MIZTWEAKZ Ping Pack: ping drops from 72 to 46 with 0% packet loss" loading="lazy">
      </div>
    </div>
  </section>

  <!-- 3. VALUES (Paragon how-it-works grid, staggered) -->
  <section class="how-it-works values reveal section" id="values" aria-labelledby="values-title">
    <div class="section-header">
      <span class="section-label">What We Stand For</span>
      <h2 class="section-title" id="values-title">Tested. Non-Intrusive. Reversible.</h2>
      <p class="section-subtitle section-subtitle--plain">Three rules every pack has to pass before being added to the app.</p>
    </div>
    <div class="steps-container" data-about="values"></div>
  </section>

  <!-- 4. REAL RESULTS (verbatim About Us copy + the Judge.me carousel) -->
  <div class="reviews-carousel-group reveal section" id="results">
    <section class="social-proof" aria-labelledby="results-title">
      <span class="section-label">Real Results</span>
      <h2 class="proof-title" id="results-title">100% Verified Reviews from our customers.</h2>
      <p class="proof-subtitle">Across every setup imaginable, Miz Tweakz consistently improves performance.</p>
      <div class="proof-line" aria-hidden="true"></div>
    </section>
    <div data-render="testimonials"></div>
  </div>

  <!-- 5. BENCHMARK VIDEOS (consent-gated YouTube embeds, Paragon .yt-gate) -->
  <section class="benchmarks section animate" id="benchmarks" aria-labelledby="bench-title">
    <div class="section-header">
      <span class="section-label">Watch It Work</span>
      <h2 class="section-title" id="bench-title">Before &amp; After, On Camera</h2>
      <p class="section-subtitle section-subtitle--plain">Straight from the MIZTWEAKZ YouTube channel. Real hardware, real numbers.</p>
    </div>
    <div class="video-grid" data-about="videos"></div>
  </section>

  <!-- 7. TRUSTED BY THE BEST (verbatim home/product section) -->
  <section class="creators-section section reveal" id="creators" aria-labelledby="creators-title">
    <div class="section-header">
      <h2 class="section-title" id="creators-title">Trusted By The BEST</h2>
      <p class="section-subtitle section-subtitle--plain">Creators who run MIZTWEAKZ packs</p>
    </div>
    <div class="creators-row" data-about="creators"></div>
    <div class="cta-container">
      <div class="nice-button-box"><a class="nice-button btn-lg" href="/pages/utilities">Join 4,000+ Active Users</a></div>
    </div>
  </section>

  <!-- 9. CLOSING CTA (About Us page "Buy Now" to the Ultimate Bundle) -->
  <section class="final-cta glass-card reveal" aria-labelledby="cta-title">
    <div class="cta-glow" aria-hidden="true"></div>
    <h2 id="cta-title">Ready to see the difference?</h2>
    <p>Download the app and join 4,000+ players already running MIZTWEAKZ.</p>
    <div class="cta-group">
      <div class="nice-button-box"><a class="nice-button btn-lg" href="/pages/utilities">See Plans</a></div>
      <a class="nice-button grey btn-lg" href="https://github.com/austins041/MizTweakz/releases/latest/download/MizTweakz-Setup.exe">Download for <span class="free-word">Free</span></a>
    </div>
  </section>

{% raw %}
<script>
/* About page: render data-driven blocks from window.MZ + consent-gated YouTube embeds (Paragon .yt-gate). */
(function () {
  'use strict';
  function ready() {
    var MZ = window.MZ, ui = MZ && MZ.ui;
    if (!ui) return;
    var esc = ui.esc, icon = ui.icon, b = MZ.brand, s = b.socials;
    var $ = function (sel, root) { return (root || document).querySelector(sel); };
    var $$ = function (sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); };

    /* metrics row (story section) */
    var metrics = $('[data-about="metrics"]');
    if (metrics) metrics.innerHTML = (MZ.metrics || []).map(function (m) {
      return '<div class="metric"><span class="metric-value">' + esc(m.value) + '</span><span class="metric-label">' + esc(m.label) + '</span></div>';
    }).join('');

    /* values grid: first three "why MIZTWEAKZ" features */
    var values = $('[data-about="values"]');
    if (values) values.innerHTML = (MZ.features || []).slice(0, 3).map(function (f, i) {
      return '<article class="step-card glass-card" style="--delay:' + (i * 0.15) + 's"><span class="step-icon">' + icon(f.icon) + '</span><h3>' + esc(f.title) + '</h3><p>' + esc(f.text) + '</p></article>';
    }).join('');

    /* creators ("Trusted By The BEST") */
    var creators = $('[data-about="creators"]');
    if (creators) creators.innerHTML = (MZ.creators || []).map(function (c) {
      var img = c.avatar
        ? '<img src="' + c.avatar + '"' + (c.avatar2x ? ' srcset="' + c.avatar + ' 1x, ' + c.avatar2x + ' 2x"' : '') + ' width="110" height="110" alt="" loading="lazy">'
        : '<span class="review-avatar" aria-hidden="true">' + esc(c.initials) + '</span>';
      return '<div class="creator">' + img + '<span class="creator-name">' + esc(c.name) + '</span><span class="creator-role">Creator</span></div>';
    }).join('');

    /* stats strip */
    var stats = $('[data-about="stats"]'), m = MZ.metrics || [];
    if (stats) stats.innerHTML = [
      { value: b.activeUsers.replace('+', '').replace(/(\d)(?=(\d{3})+$)/g, '$1,') + '+', label: 'Active Users', desc: '' },
      { value: b.reviewAverage.toFixed(2) + '★', label: 'Average Rating', desc: '' },
      m[0] || {}, m[1] || {}
    ].map(function (x) {
      return '<div class="metric"><span class="metric-value">' + esc(x.value) + '</span><span class="metric-label">' + esc(x.label) + '</span></div>';
    }).join('');

    /* team socials */
    var labels = { youtube: 'YouTube', tiktok: 'TikTok', instagram: 'Instagram', discord: 'Discord', discordContact: 'Discord', twitch: 'Twitch', kick: 'Kick' };
    $$('[data-about="socials"]').forEach(function (box) {
      box.innerHTML = box.getAttribute('data-socials').split(',').map(function (k) {
        var name = k === 'discordContact' ? 'discord' : k;
        return '<a class="social-btn" href="' + esc(s[k]) + '" target="_blank" rel="noopener noreferrer" aria-label="' + labels[k] + '">' + icon(name) + '</a>';
      }).join('');
    });

    /* team card expand (Paragon .expand-btn to .card-expanded) */
    $$('.expand-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var card = btn.closest('.team-card'), open = !card.classList.contains('card-expanded');
        card.classList.toggle('card-expanded', open);
        btn.setAttribute('aria-expanded', String(open));
        btn.firstElementChild.textContent = open ? 'Less' : 'More';
      });
    });

    /* consent-gated YouTube embeds */
    var PLAY = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    function gate(v, allowed) {
      if (allowed) {
        return '<iframe src="https://www.youtube-nocookie.com/embed/' + esc(v.id) + '" title="' + esc(v.title) + ', MIZTWEAKZ benchmark" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>';
      }
      return '<div class="yt-gate-placeholder">' +
        '<span class="yt-gate-play" aria-hidden="true">' + PLAY + '</span>' +
        '<p class="yt-gate-text">This YouTube video only loads once <strong>functional cookies</strong> are enabled.</p>' +
        '<div class="yt-gate-actions">' +
          '<button type="button" class="nice-button btn-sm" data-yt-allow>Enable &amp; play</button>' +
          '<a class="btn-clear sm" href="https://www.youtube.com/watch?v=' + esc(v.id) + '" target="_blank" rel="noopener noreferrer"><span>Watch on YouTube</span>' + icon('external') + '</a>' +
        '</div>' +
        '<button type="button" class="yt-gate-manage" data-modal="cookie-prefs">Manage cookie preferences</button>' +
      '</div>';
    }
    var grid = $('[data-about="videos"]');
    function renderVideos() {
      if (!grid) return;
      var c = ui.consent.get(), allowed = !!(c && c.functional);
      grid.innerHTML = (b.videos || []).map(function (v) {
        return '<article class="video-card glass-card"><span class="spec-label">Test system</span><h3>' + esc(v.title) + '</h3><div class="yt-gate">' + gate(v, allowed) + '</div></article>';
      }).join('');
    }
    renderVideos();
    document.addEventListener('mz:consent', renderVideos);
    if (grid) grid.addEventListener('click', function (e) {
      if (!e.target.closest('[data-yt-allow]')) return;
      var c = ui.consent.get() || {};
      ui.consent.save({ functional: true, advertisement: !!c.advertisement });
    });

    ui.hydrateIcons(document);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', ready); else ready();
})();
</script>
{% endraw %}
