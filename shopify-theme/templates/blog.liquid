{% comment %}
  Blog listing (/blogs/news and any other blog). Banner, then a card per
  article with its title, date, excerpt and a read link, 12 per page.
{% endcomment %}

{% style %}
  /* this template is one of the dense ones (static .page--tight) */
  #main-content { gap: clamp(2rem, 4vw, 4rem); }

  .article-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 24px; width: 100%; max-width: var(--max-content); margin: 0 auto; }
  .article-card { display: flex; flex-direction: column; gap: .75rem; }
  .article-card__media { border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 16 / 9; background: rgba(255, 255, 255, .04); }
  .article-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .article-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-family: var(--font-display); font-size: .8rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .article-meta .meta-dot { width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: .6; }
  .article-card__title { font-size: 1.2rem; font-weight: 600; line-height: 1.3; }
  .article-card__title a { color: #fff; transition: color .2s ease; }
  .article-card__title a:hover { color: var(--accent); }
  .article-card__excerpt { color: var(--text-70); font-size: .95rem; line-height: 1.6; }
  .article-card .btn-clear { margin-top: auto; align-self: flex-start; }
  .blog-pagination { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.25rem; margin-top: clamp(2rem, 4vw, 3rem); }
  .blog-pagination-status { color: var(--muted); font-size: .9rem; }
  .blog-empty { max-width: 60ch; margin: 0 auto; text-align: center; color: var(--text-70); line-height: 1.7; }
{% endstyle %}

  <section class="banner" data-mount aria-labelledby="blog-title">
    <div class="banner-content">
      <h1 class="banner-title" id="blog-title">{{ blog.title }}</h1>
      {%- if current_tags %}
        <div class="banner-pills">
          {%- for tag in current_tags %}
            <span class="title-tag">{{ tag }}</span>
          {%- endfor %}
          <a class="title-tag nav-tag" href="{{ blog.url }}">Clear filter</a>
        </div>
      {%- endif %}
    </div>
  </section>

  {% paginate blog.articles by 12 %}
    <section class="section animate" aria-label="Articles">
      {% if blog.articles.size > 0 %}
        <div class="article-grid">
          {% for article in blog.articles %}
            <article class="glass-card glass-card--pad glass-card--hover article-card">
              {% if article.image %}
                <a class="article-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                  <img src="{{ article.image | image_url: width: 800 }}" width="800" height="450" alt="" loading="lazy">
                </a>
              {% endif %}
              <p class="article-meta">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time>
                {%- if article.author != blank %}
                  <span class="meta-dot" aria-hidden="true"></span>
                  <span>{{ article.author }}</span>
                {%- endif %}
              </p>
              <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              {% if article.excerpt_or_content != blank %}
                <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 32 }}</p>
              {% endif %}
              <a class="btn-clear sm" href="{{ article.url }}"><span>Read article</span><span class="btn-clear__arrow"><i data-icon="arrow-right"></i></span></a>
            </article>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="blog-pagination" aria-label="Pagination">
            {% if paginate.previous %}
              <a class="btn-clear sm" href="{{ paginate.previous.url }}"><span>Newer posts</span></a>
            {% endif %}
            <span class="blog-pagination-status">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {% if paginate.next %}
              <a class="btn-clear sm" href="{{ paginate.next.url }}"><span>Older posts</span></a>
            {% endif %}
          </nav>
        {% endif %}
      {% else %}
        <p class="blog-empty">There are no posts here yet. New guides, benchmarks and release notes land on this page first.</p>
      {% endif %}
    </section>
  {% endpaginate %}

