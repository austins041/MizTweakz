{% comment %}
  Utilities page. Ported from the static site/utilities/index.html: banner, the
  app screenshot coverflow, the feature grid, the plans, the download card and
  the FAQ.

  Two changes against the static source:
    1. the Basic and Ultimate buy buttons link to the real Shopify products
       (all_products['basic'] / all_products['ultimate']) instead of an
       external store URL, falling back to the /products/ path for that handle;
    2. their prices render from Shopify when the product is there, falling back
       to the static figures.
{% endcomment %}

{{ 'page-utilities.css' | asset_url | stylesheet_tag }}

{% style %}
  /* page-utilities.css scopes these to .utilities-page; the layout owns the main.page wrapper, so they are set here */
  #main-content {
    --gold: #fbbf24;        /* Paragon Apex tier */
    --gold-rgb: 251, 191, 36;
    --teal: #10b981;        /* Paragon .discount-badge / sale colour */
    --teal-rgb: 16, 185, 129;
    --plan-green: #22c55e;  /* "Your Plan" pill (owner screenshot) */
    --blue: #3b82f6;        /* Paragon "Downloads" tag */
  }
{% endstyle %}

{%- assign basic_product = all_products['basic'] -%}
{%- assign ultimate_product = all_products['ultimate'] -%}

{%- assign basic_url = '/products/basic' -%}
{%- assign basic_price = '$7.99' -%}
{%- assign basic_monthly = '799' -%}
{%- if basic_product != empty -%}
  {%- assign basic_url = basic_product.url -%}
  {%- if basic_product.price > 0 -%}
    {%- assign basic_price = basic_product.price | money -%}
    {%- assign basic_monthly = basic_product.price -%}
  {%- endif -%}
{%- endif -%}

{%- assign ultimate_url = '/products/ultimate' -%}
{%- assign ultimate_price = '$14.99' -%}
{%- assign ultimate_monthly = '1499' -%}
{%- if ultimate_product != empty -%}
  {%- assign ultimate_url = ultimate_product.url -%}
  {%- if ultimate_product.price > 0 -%}
    {%- assign ultimate_price = ultimate_product.price | money -%}
    {%- assign ultimate_monthly = ultimate_product.price -%}
  {%- endif -%}
{%- endif -%}

{%- assign tos_url = '/pages/terms-of-service' -%}
{%- if shop.terms_of_service.url != blank -%}
  {%- assign tos_url = shop.terms_of_service.url -%}
{%- endif -%}

