        { "@type": "Offer", "name": "Ultimate", "price": "{{ ultimate_num }}", "priceCurrency": {{ cart.currency.iso_code | json }}, "url": {{ request.origin | append: ultimate_url | json }} }
      ]
    }
  }
  </script>
