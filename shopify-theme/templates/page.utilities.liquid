    "featureList": [
      "525 Windows tweaks across 13 categories",
      "One click apply and revert, with restore points",
      "App debloat and per-app optimizer",
      "FPS Boost standby list trimmer",
      "Crosshair overlay designer",
      "Network tools and DNS benchmark",
      "Startup manager and storage cleanup"
    ],
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
    "offers": {
      "@type": "AggregateOffer",
