{% raw %}
<script>
/* Utilities page: screenshot coverflow, billing toggle (Monthly / 6 Months 17% off / Annual 25% off),
   LED active-users counter, checksum copy button, download buttons synced from MZ.download.
   Runs after the deferred data.js + site.js. */
(function () {
  'use strict';
  var PERIODS = {
    monthly: { months: 1, off: 0, status: 'Monthly pricing.' },
    six: { months: 6, off: .17, suffix: ' every 6 months', status: '6 month pricing, 17% off, billed every 6 months.' },
    annual: { months: 12, off: .25, suffix: ' per year', status: 'Annual pricing, 25% off, billed once per year.' }
  };
  function money(cents) { return '$' + (cents / 100).toFixed(2); }
  /* billed = monthly x months x (1 - discount), rounded to the cent; the shown per-month figure is billed / months */
  function quote(monthlyCents, p) {
    var billed = Math.round(monthlyCents * p.months * (1 - p.off));
    return { billed: billed, perMonth: Math.round(billed / p.months) };
  }

  function ready() {
    var MZ = window.MZ || {}, ui = MZ.ui;
    var $ = function (sel, root) { return (root || document).querySelector(sel); };
    var $$ = function (sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); };
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* download buttons follow MZ.download (label goes into the inner span so icons survive) */
    if (MZ.download && MZ.download.href) $$('[data-download]').forEach(function (a) {
      a.setAttribute('href', MZ.download.href);
      a.removeAttribute('download'); /* cross-origin: the attribute is ignored by browsers anyway */
      var label = $('span', a);
