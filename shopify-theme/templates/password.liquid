{% comment %}
  Storefront password page. Rendered inside layout/password.liquid, which is
  self contained because the main navigation is not available here.
{% endcomment %}

<div class="commerce-password-shell">
  <img class="commerce-password-logo"
       src="{{ 'brand-logo-96.png' | asset_url }}"
       alt="{{ shop.name | escape }}"
       width="96"
       height="96">

  <h1 class="commerce-password-title">{{ shop.name | escape }}</h1>

  {%- if shop.password_message != blank -%}
    <p class="section-description">{{ shop.password_message }}</p>
  {%- else -%}
    <p class="section-description">The store is opening soon. Enter the password if you have one.</p>
  {%- endif -%}

  <div class="glass-card commerce-password-card">
    {% form 'storefront_password' %}
      {%- if form.errors -%}
        <div class="status-message status-message--error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div>
        <label class="form-label" for="commerce-password-input">Password</label>
        <input class="form-input"
               type="password"
               id="commerce-password-input"
               name="password"
               autocomplete="current-password"
               required>
      </div>

      <div class="nice-button-box">
        <button type="submit" class="nice-button btn-md">Enter store</button>
      </div>
    {% endform %}
  </div>

  <p class="commerce-password-foot">
    Are you the store owner? <a href="/admin">Log in here</a>.
  </p>
</div>
