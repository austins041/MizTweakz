{% comment %}
  Gift card. Minimal and printable: balance, code, QR and expiry.
  The QR image is drawn by Shopify's own hosted qrcode.js, so the theme does
  not need to ship a library. Header and footer come from the layout.
{% endcomment %}

{% style %}
  .commerce-giftcard { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; padding: clamp(1.5rem, 4vw, 2.5rem); text-align: center; }
  .commerce-giftcard-balance { font-family: var(--font-display); font-size: clamp(2.5rem, 8vw, 4rem); font-weight: 900; line-height: 1; color: #fff; }
  .commerce-giftcard-code { font-family: var(--font-mono); font-size: 1.25rem; letter-spacing: .12em; color: #fff; padding: 12px 18px; border: 1px dashed var(--hairline); border-radius: var(--radius-md); user-select: all; word-break: break-all; }
  .commerce-giftcard-qr { display: flex; justify-content: center; padding: 12px; background: #fff; border-radius: var(--radius-md); }
  .commerce-giftcard-qr img, .commerce-giftcard-qr canvas { display: block; }
  .commerce-giftcard-meta { font-size: .9rem; color: var(--text-50); }
{% endstyle %}

<section class="section" data-mount aria-labelledby="commerce-giftcard-title">
  <div class="container container--narrow">
    <div class="glass-card commerce-giftcard">
      <h1 class="section-subtitle" id="commerce-giftcard-title">Gift card for {{ shop.name | escape }}</h1>

      {%- if gift_card.expired or gift_card.enabled == false -%}
        <span class="status-badge status-badge--error">
          {%- if gift_card.expired -%}Expired{%- else -%}Disabled{%- endif -%}
        </span>
      {%- else -%}
        <span class="status-badge status-badge--success">Active</span>
      {%- endif -%}

      <p class="commerce-giftcard-balance">{{ gift_card.balance | money }}</p>

      {%- if gift_card.balance != gift_card.initial_value -%}
        <p class="commerce-giftcard-meta">Originally {{ gift_card.initial_value | money }}</p>
      {%- endif -%}

      <div class="commerce-giftcard-qr" id="commerce-giftcard-qr" data-identifier="{{ gift_card.qr_identifier }}"></div>

      <p class="commerce-giftcard-code">{{ gift_card.code | format_code }}</p>

      <p class="commerce-giftcard-meta">
        Use this code at checkout.
        {%- if gift_card.expires_on -%}
          {%- if gift_card.expired -%}
            It expired on {{ gift_card.expires_on | date: '%B %e, %Y' }}.
          {%- else -%}
            It expires on {{ gift_card.expires_on | date: '%B %e, %Y' }}.
          {%- endif -%}
        {%- else -%}
          It does not expire.
        {%- endif -%}
      </p>

      <div class="nice-button-box">
        <a class="nice-button btn-md" href="{{ shop.url }}">Start shopping</a>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var target = document.getElementById('commerce-giftcard-qr');
    if (!target || typeof QRCode === 'undefined') return;
    var identifier = target.getAttribute('data-identifier');
    if (!identifier) return;
    new QRCode(target, { text: identifier, width: 140, height: 140 });
  });
</script>
