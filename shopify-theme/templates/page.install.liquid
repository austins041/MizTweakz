{% comment %}
  Post-download install guide. Deliberately simple: a heading, the video, four
  short steps, and a way to download again. Nothing else.

  The download starts HERE rather than from the button that sent you, because
  the old approach raced: it began the download from the link's href and then
  navigated 900ms later, and if GitHub's redirect to its CDN was slow the
  navigation cancelled the download. Now the button just navigates and this page
  triggers the file, so both always happen.

  Unlisted: noindex, and in no navigation menu.
{% endcomment %}

{{ 'page-legal.css' | asset_url | stylesheet_tag }}

<meta name="robots" content="noindex, follow">

{%- assign dl = 'https://github.com/austins041/MizTweakz/releases/latest/download/MizTweakz-Setup.exe' -%}
{%- if settings.download_url != blank -%}{%- assign dl = settings.download_url -%}{%- endif -%}

<section class="section install-page" aria-labelledby="install-title">
  <div class="container install-wrap">

    <span class="title-tag" style="--color:#22c55e">Downloading now</span>
    <h1 class="install-h1" id="install-title">Watch this while it downloads</h1>
    <p class="install-lead">
      MizTweakz-Setup.exe is on its way to your Downloads folder. This video walks through the
      whole setup, start to finish.
    </p>

    {%- if settings.install_video_url != blank -%}
      <video
        class="install-video"
        controls
        playsinline
        preload="metadata"
        width="1920" height="1080"
        poster="{{ 'install-guide-poster.jpg' | asset_url }}">
        <source src="{{ settings.install_video_url }}" type="video/mp4">
        Your browser cannot play this video. The steps below cover the same ground.
      </video>
    {%- endif -%}

    <ol class="install-steps">
      <li>Run <b>MizTweakz-Setup.exe</b> from your Downloads folder.</li>
      <li>Allow it when Windows asks for <b>administrator rights</b>. The tweaks need them.</li>
      <li><b>Sign in</b> and your plan unlocks inside the app.</li>
      <li><b>Make a restore point</b>, then start applying tweaks. Anything can be reverted.</li>
    </ol>

    <p class="install-again">
      Download did not start?
      <a href="{{ dl }}" data-no-guide>Get it again</a>
      &nbsp;·&nbsp; <a href="/pages/safe">Is it safe?</a>
      &nbsp;·&nbsp; <a href="/pages/tweaks">All 525 tweaks</a>
    </p>

  </div>
</section>

<script>
  (function () {
    var url = {{ dl | json }};
    function start() {
      try {
        var a = document.createElement("a");
        a.href = url;
        a.rel = "noopener";
        /* Without this, site.js treats the synthetic click as a download button,
           cancels it and redirects back here, looping the page forever. */
        a.setAttribute("data-no-guide", "");
        a.style.display = "none";
        document.body.appendChild(a);
        a.click();
        a.remove();
      } catch (err) { /* the "Get it again" link is the fallback */ }
    }
    /* After load, not during parsing: starting it mid-parse aborts the
       document and the rest of the page never initialises. */
    if (document.readyState === "complete") setTimeout(start, 400);
    else window.addEventListener("load", function () { setTimeout(start, 400); });
  })();
</script>

{%- if settings.install_video_url != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "How to install MizTweakz",
  "description": "Installing the MizTweakz Windows app: running the installer, granting administrator rights, signing in, making a restore point and applying your first tweaks.",
  "thumbnailUrl": [{{ 'install-guide-poster.jpg' | asset_url | prepend: request.origin | json }}],
  "uploadDate": "2026-09-16",
  "duration": "PT1M36S",
  "contentUrl": {{ settings.install_video_url | json }},
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
}
</script>
{%- endif -%}
