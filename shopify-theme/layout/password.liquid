<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1f1f21">
  <meta name="robots" content="noindex, nofollow">

  <title>{{ shop.name | escape }}</title>

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ 'brand-favicon-32.png' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'brand-favicon-180.png' | asset_url }}">

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&display=swap">
  {{ 'site.css' | asset_url | stylesheet_tag }}

  {% style %}
    /* The password page cannot use the main navigation, so it carries its own
       centred shell. Colours and fonts come from site.css tokens. */
    body.commerce-password {
      min-height: 100dvh;
      background: #1f1f21;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }
    .commerce-password-shell {
      width: 100%;
      max-width: 440px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.75rem;
      text-align: center;
    }
    .commerce-password-logo { width: 96px; height: auto; }
    .commerce-password-title {
      font-family: "Outfit", sans-serif;
      font-size: clamp(1.9rem, 6vw, 2.6rem);
      font-weight: 900;
      line-height: 1.1;
      color: #fff;
    }
    .commerce-password-card { width: 100%; padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem; }
    .commerce-password-card .form-label { text-align: left; }
    .commerce-password-foot { font-size: .85rem; color: var(--text-50); }
    .commerce-password-foot a { text-decoration: underline; }
  {% endstyle %}
</head>
<body class="commerce-password">
  {{ content_for_layout }}
</body>
</html>
