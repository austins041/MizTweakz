/* =========================================================================
   MIZTWEAKZ — site.css
   Paragon Tweaks' layout/components re-skinned with the MIZTWEAKZ palette.
   Sections: 1 tokens · 2 base · 3 typography · 4 layout · 5 header · 6 buttons
   7 cards & chips · 8 hero · 9 home sections · 10 marquees · 11 FAQ · 12 footer
   13 modals · 14 cookie consent · 15 banner/forms (Phase B) · 16 motion/a11y
   ========================================================================= */

/* ---------- 1. TOKENS ---------- */
:root {
  --font-display: "Outfit", "Amenti", sans-serif; /* Outfit = closest free match to Paragon's licensed Amenti (owner choice 2026-09-05) */
  --font-body: "Roboto", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Oxygen, Ubuntu, Cantarell, "Fira Sans", "Droid Sans", "Helvetica Neue", sans-serif; /* Paragon's exact stack; Roboto is not loaded, so it resolves to the system font just like Paragon */
  --font-mono: "JetBrains Mono", "SF Mono", Consolas, Monaco, monospace;

  /* surfaces + text */
  --bg: #1f1f21;
  --surface: #2b2b2e;
  --hairline: rgba(255, 255, 255, .10);
  --hairline-soft: rgba(255, 255, 255, .06);
  --heading: #ffffff;
  --text: #c7c7c8;
  --muted: #8f8f90;
  --text-70: rgba(255, 255, 255, .70);
  --text-50: rgba(255, 255, 255, .50);

  /* accents: Paragon's exact --main #bc312a / --accent-bright #e85a51 (owner request 2026-09-05) */
  --accent: #d92b21;
  --accent-rgb: 217, 43, 33;
  --accent-bright: #ff5b50;
  --accent-ink: #ffffff;
  --accent-2: #ff7a70;
  --accent-2-rgb: 255, 122, 112;
  --discord: #4296fe;
  --success: #22c55e;
  --error: #ef4444;

  /* ambient lighting: grayish-white glows/halos behind imagery (owner request 2026-09-08; accent stays red) */
  --ambient: #e6e6ec;
  --ambient-rgb: 230, 230, 236;
  --ambient-2: #ffffff;
  --ambient-2-rgb: 255, 255, 255;

  /* pack category colors */
  --cat-fps: #d92b21;
  --cat-ping: #ff7a70;
  --cat-delay: #ffffff;
  --cat-ultimate: #d92b21;
  --cat-ultimate-2: #ff7a70;
  --gradient-ultimate: linear-gradient(90deg, var(--cat-ultimate), var(--cat-ultimate-2));

  /* glass */
  --glass: rgba(0, 0, 0, .30);
  --glass-panel: rgba(10, 10, 10, .80);
  --glass-blur: 3px;
  --panel-blur: 8px;

  /* radii (Paragon) */
  --radius-xl: 22px;
  --radius-lg: 15px;
  --radius-md: 12px;
  --radius-sm: 10px;
  --radius-xs: 8px;

  /* layout + motion */
  --nav-height: 97px;
  --max-content: 1400px;
  --ease-out-expo: cubic-bezier(.16, 1, .3, 1);
  --z-nav: 1000;
  --z-menu: 999;
  --z-revisit: 1500;
  --z-notice: 1900;
  --z-modal: 2000;
}

/* ---------- 2. BASE ---------- */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.6;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  transition: opacity .22s ease;
}
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  background: #1f1f21 url({{ 'texture.svg' | asset_url }}) center / cover no-repeat;
  pointer-events: none;
}
body.is-leaving { opacity: 0; }
body.modal-open, body.menu-open { overflow: hidden; }
/* Paragon: headings inherit the app's display face at 400 and the body line-height (1.6); components set their own size/weight/line-height */
h1, h2, h3, h4, h5, h6 {
  margin: 0;
  font-family: var(--font-display);
  font-weight: 400;
  color: var(--heading);
}
p { margin: 0; }
a { color: inherit; text-decoration: none; }
img, svg, video { display: block; max-width: 100%; }
ul, ol { margin: 0; padding: 0; list-style: none; }
button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
input, textarea, select { font: inherit; }
:focus-visible { outline: 2px solid var(--accent-bright); outline-offset: 2px; }

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.skip-link {
  position: fixed; top: 0; left: 0; z-index: 10000;
  padding: 12px 20px; border-radius: 0 0 8px;
  background: var(--accent); color: #fff;
  font-family: var(--font-display); font-weight: 700;
  transform: translateY(-150%); transition: transform .2s ease;
}
.skip-link:focus { transform: translateY(0); outline: 2px solid #fff; outline-offset: 2px; }

/* inline icons (rendered from <i data-icon> by site.js or hand-written) */
.icon { width: 1em; height: 1em; display: inline-block; vertical-align: -.125em; flex: none; }
.icon-wrap { display: inline-flex; align-items: center; justify-content: center; line-height: 0; }

/* ---------- 3. TYPOGRAPHY ---------- */
.section-label, .eyebrow {
  display: block;
  font-size: .75rem; font-weight: 500;
  letter-spacing: .25em; text-transform: uppercase;
  color: var(--accent);
}
.section-label--muted { color: var(--text-50); }
.section-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; line-height: 1.1; }
.section-subtitle { font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 600; color: var(--accent); margin: 0 0 .5rem; }
.section-subtitle--plain { color: var(--text-50); font-family: var(--font-body); font-weight: 400; font-size: 1.1rem; margin: 0; }
.section-description { font-size: 1rem; line-height: 1.8; color: var(--text-70); }
.highlight { color: #fff; font-weight: 500; }
.text-accent { color: var(--accent); }
.text-accent-2 { color: var(--accent-2); }
.text-gradient { background: var(--gradient-ultimate); -webkit-background-clip: text; background-clip: text; color: transparent; }
.text-center { text-align: center; }
.mono { font-family: var(--font-mono); font-size: .85rem; }

/* ---------- 4. LAYOUT ---------- */
.page {
  display: flex; flex-direction: column;
  gap: clamp(3rem, 6vw, 5rem);
  padding: 0 20px;
  margin-top: var(--nav-height);
}
@supports (overflow-x: clip) { .page { overflow-x: clip; } } /* clips decorative glows without creating a scroll container */
.page--tight { gap: clamp(2rem, 4vw, 4rem); }
.container { width: 100%; max-width: var(--max-content); margin: 0 auto; }
.container--narrow { max-width: 900px; }
.section { scroll-margin-top: var(--nav-height); width: 100%; }
.section-header { display: flex; flex-direction: column; align-items: center; gap: .75rem; text-align: center; }
.section-header .section-title { margin-bottom: .25rem; } /* Paragon: label→title .75rem, title→subtitle 1rem */
.section-header--left { align-items: flex-start; text-align: left; }
.stack { display: flex; flex-direction: column; gap: 1rem; }
.row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
.center { display: flex; justify-content: center; }

/* ---------- 5. HEADER ---------- */
.nav-container {
  position: fixed; top: 0; left: 0; width: 100%;
  z-index: var(--z-nav);
  font-family: var(--font-display); font-weight: 400;
  user-select: none;
}
.nav { position: relative; display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 20px; }
.nav-left { display: flex; flex-direction: row; align-items: center; gap: 10px; }

/* glass pill shared by logo box, tab bar, hamburger (Paragon .nav-tab-container) */
.nav-pill {
  position: relative;
  display: flex; align-items: center; gap: 15px;
  width: fit-content;
  padding: 10px 15px;
  background: var(--glass);
  -webkit-backdrop-filter: blur(var(--glass-blur));
  backdrop-filter: blur(var(--glass-blur));
  border-radius: var(--radius-lg);
  border-top: 1px solid var(--hairline);
  border-bottom: 1px solid var(--hairline);
}
.nav-pill::before, .nav-pill::after,
.dropdown-panel::before, .dropdown-panel::after,
.glass-card::before, .glass-card::after {
  content: ""; position: absolute; left: 0; right: 0; height: 30px; pointer-events: none;
}
.nav-pill::before, .dropdown-panel::before, .glass-card::before { top: 0; background: linear-gradient(to bottom, rgba(255, 255, 255, .02), transparent); border-radius: inherit; }
.nav-pill::after, .dropdown-panel::after, .glass-card::after { bottom: 0; background: linear-gradient(to top, rgba(255, 255, 255, .025), transparent); border-radius: inherit; }
.nav-pill.compact { padding: 3px; }

.logo-container { color: #fff; justify-content: space-evenly; gap: 10px; cursor: pointer; }
.logo-container img { width: 30px; height: 30px; object-fit: contain; }
.logo-text { font-size: 18px; margin-right: 4px; }

.tab-container {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  display: none; flex-direction: row; gap: 15px;
}
/* Paragon .nav-tab: no border by default; the active state adds 1px borders (the tab grows 2px, exactly like the original) */
.nav-tab {
  position: relative;
  display: flex; align-items: center; gap: 10px;
  padding: 8px 18px;
  border-radius: 12px;
  background: none; border: none;
  color: var(--muted);
  font-family: inherit; font-size: inherit;
  white-space: nowrap;
  cursor: pointer;
  transition: all .3s ease;
}
.nav-tab .icon-wrapper {
  display: inline-flex; width: 0; opacity: 0; overflow: hidden; visibility: hidden; pointer-events: none;
  transform: translateX(-20px);
  transition: width .3s ease-out, transform .3s ease-out, visibility .3s ease-out, opacity .3s ease-out;
}
.nav-tab .icon-wrapper .icon { width: 16px; height: 16px; }
.nav-tab:hover, .nav-tab:focus-visible, .nav-tab.active { color: #fff; }
.nav-tab:hover { background: rgba(255, 255, 255, .05); border-color: rgba(255, 255, 255, .08); transform: translateY(-1px); }
.nav-tab:hover .icon-wrapper, .nav-tab.active .icon-wrapper, .nav-tab:focus-visible .icon-wrapper { width: 20px; opacity: 1; visibility: visible; transform: none; }
.nav-tab.active {
  z-index: 1;
  background:
    radial-gradient(ellipse at top left, rgba(26, 26, 26, .9) 70%, transparent 90%),
    radial-gradient(ellipse at top right, rgba(26, 26, 26, .9) 70%, transparent 90%),
    linear-gradient(to bottom, rgba(var(--ambient-rgb), calc(.10 * var(--glow, 1))), rgba(var(--ambient-rgb), calc(.40 * var(--glow, 1))) 90%, rgba(var(--ambient-rgb), calc(.2 * var(--glow, 1))));
  border-top: 1px solid rgba(var(--ambient-rgb), calc(.2 * var(--glow, 1)));
  border-bottom: 1px solid rgba(var(--accent-rgb), .8);
  border-left: 1px solid rgba(var(--ambient-rgb), calc(.4 * var(--glow, 1)));
  border-right: 1px solid rgba(var(--ambient-rgb), calc(.4 * var(--glow, 1)));
}
/* blurred glow under the tab (Paragon: bottom -4px, 60% × 60%, blur 8px) */
.nav-tab.active::before {
  content: ""; position: absolute; bottom: -4px; left: 50%; transform: translateX(-50%);
  width: 60%; height: 60%;
  background: radial-gradient(ellipse at center, rgba(var(--ambient-rgb), calc(.45 * var(--glow, 1))), transparent 100%);
  filter: blur(8px); pointer-events: none; z-index: -1;
}
/* 2px halo behind the tab, fading upward (Paragon: inset -2px, radius 14px, opacity .8) */
.nav-tab.active::after {
  content: ""; position: absolute; inset: -2px;
  background: linear-gradient(to top, rgba(var(--ambient-rgb), calc(.3 * var(--glow, 1))) 0%, rgba(var(--ambient-rgb), calc(.2 * var(--glow, 1))) 30%, rgba(var(--ambient-rgb), calc(.1 * var(--glow, 1))) 60%, rgba(var(--ambient-rgb), calc(.05 * var(--glow, 1))) 80%, transparent 100%);
  border-radius: 14px; z-index: -2; pointer-events: none; opacity: .8;
}
/* 1px underline glow (Paragon .active-tab-underline, measured by JS; ours spans the active tab) */
.active-tab-underline { display: none; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; border-radius: 2px; background: linear-gradient(to right, transparent, rgba(var(--accent-rgb), .6), transparent); pointer-events: none; z-index: 2; }
.nav-tab.active > .active-tab-underline { display: block; }
.new-badge {
  font-family: inherit;
  font-size: .6rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
  padding: 2px 6px; border-radius: 4px; margin-left: 2px; white-space: nowrap;
  background: linear-gradient(135deg, var(--accent), var(--accent-bright));
  color: #fff;
}

/* Packs hover dropdown (Paragon Services panel: .dropdown wrapper padding 10px / gap 10px + .dropdown-panel glass) */
.nav-dropdown-wrap { position: relative; display: flex; }
.nav-dropdown-wrap::after { content: ""; position: absolute; top: 100%; left: 0; right: 0; height: 16px; } /* hover bridge to the panel */
.dropdown-panel {
  position: absolute; top: calc(100% + 15px); left: 50%;
  transform: translate(-50%, -10px);
  padding: 10px;
  display: flex; flex-direction: column; gap: 10px;
  background: var(--glass-panel);
  -webkit-backdrop-filter: blur(var(--panel-blur));
  backdrop-filter: blur(var(--panel-blur));
  border-radius: var(--radius-lg);
  border-top: 1px solid rgba(255, 255, 255, .3);
  border-bottom: 1px solid rgba(255, 255, 255, .2);
  opacity: 0; visibility: hidden; pointer-events: none;
  transition: opacity .25s ease, transform .25s ease, visibility 0s linear .25s;
  z-index: 5;
}
.nav-dropdown-wrap.open .dropdown-panel { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(-50%, 0); transition-delay: 0s; }
.dropdown-panel .nav-tab { justify-content: flex-start; --color: var(--accent); }
.dropdown-panel .nav-tab .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color); box-shadow: 0 0 8px var(--color); flex: none; }
.dropdown-panel .nav-tab .dot--gradient { background: var(--gradient-ultimate); box-shadow: 0 0 8px rgba(var(--ambient-rgb), calc(.6 * var(--glow, 1))); }
.dropdown-panel .nav-tab small { margin-left: auto; font-family: var(--font-body); font-size: .75rem; color: var(--muted); }

.nav-user-controls { display: flex; flex-direction: row; align-items: center; gap: 10px; }
.btn-clear.discord .icon { width: 30px; height: 24px; } /* Paragon's discord logo image is 30×24 → 46px pill */

.hamburger-container {
  display: flex; justify-content: center; align-items: center;
  height: 50px; padding: 0 15px;
  color: rgba(255, 255, 255, .6);
  cursor: pointer;
  transition: box-shadow .1s ease-in-out;
}
.hamburger-container .icon { width: 16px; height: 16px; }
.hamburger-container:hover, .hamburger-container[aria-expanded="true"] { box-shadow: 0 0 5px rgba(var(--ambient-rgb), calc(.7 * var(--glow, 1))); }

.nav-container .mobile-menu { /* outranks .glass-card { position: relative }, which turned the drawer into an in-flow 100%-wide block */
  position: absolute; top: 90px; left: 20px; right: 20px;
  z-index: var(--z-menu);
  padding: 8px;
  display: flex; flex-direction: column; gap: 4px;
  background: rgba(0, 0, 0, .5);
  max-height: calc(100dvh - 110px); overflow-y: auto;
  opacity: 0; transform: translateY(-10px); visibility: hidden;
  transition: opacity .25s ease, transform .25s ease, visibility 0s linear .25s;
}
.mobile-menu.open { opacity: 1; transform: none; visibility: visible; transition-delay: 0s; }
.mobile-menu-item {
  display: flex; align-items: center; gap: 12px; width: 100%;
  padding: 12px 16px; border-radius: 8px;
  font-family: var(--font-body); font-size: 1rem; text-align: left;
  color: rgba(255, 255, 255, .7);
  cursor: pointer;
  transition: all .2s ease;
}
.mobile-menu-item .icon { width: 20px; height: 20px; }
.mobile-menu-item:hover { background: rgba(255, 255, 255, .05); color: #fff; }
.mobile-menu-item.active { background: rgba(var(--ambient-rgb), calc(.15 * var(--glow, 1))); color: var(--accent-bright); }
.mobile-menu-sub { display: flex; flex-wrap: wrap; gap: 8px; padding: 2px 16px 10px 48px; }
.mobile-menu-sub a { font-family: var(--font-body); font-size: .8rem; min-height: 40px; padding: 6px 12px; } /* 40px touch target */

/* Paragon's NavBar is "mobile" up to and including 1415px (isMobile = innerWidth <= 1415, JS-driven; mirrored here as a media query) */
@media (min-width: 1416px) {
  .tab-container { display: flex; }
  .hamburger-container, .nav-container .mobile-menu { display: none; }
}
@media (max-width: 1415px) {
  .logo-text { display: none; }
}
/* Paragon NavBar: squishDiscord = innerWidth <= 407 → the pill swaps to a short "Login" label (≈124px) */
.btn-clear.discord .btn-text-short { display: none; }
@media (max-width: 407px) {
  .btn-clear.discord .btn-text { display: none; }
  .btn-clear.discord .btn-text-short { display: flex; }
}

/* ---------- 6. BUTTONS ---------- */
/* Paragon .nice-button-box / .nice-button verbatim (dark #2c2c2c face with a radial --color tint; sizes carry the padding) */
.nice-button-box {
  --btn-color: var(--color, var(--accent));
  display: inline-flex; align-items: stretch; width: fit-content;
  padding: 2px;
  border-radius: 15px;
  background-color: #141414;
  border-bottom: 1px solid rgba(150, 150, 150, .3);
  box-shadow: inset 2px 0 4px rgba(255, 255, 255, .03), inset -2px 0 4px rgba(255, 255, 255, .03), inset 0 -2px 4px rgba(255, 255, 255, .03);
}
.nice-button-box .nice-button { width: 100%; }
.nice-button {
  --btn-color: var(--color, var(--accent));
  display: flex; justify-content: center; align-items: center; gap: 8px;
  background:
    radial-gradient(ellipse at center, rgba(var(--ambient-rgb), calc(.30 * var(--glow, 1))) 0%, rgba(var(--ambient-rgb), calc(.20 * var(--glow, 1))) 40%, rgba(var(--ambient-rgb), calc(.10 * var(--glow, 1))) 70%, transparent 100%),
    #2c2c2c;
  color: #e5e5e5;
  border: none;
  border-radius: 12px;
  font-family: var(--font-display); font-weight: 400; letter-spacing: .01em;
  cursor: pointer;
  transition: all .2s ease;
  box-shadow: 0 2px 4px rgba(0, 0, 0, .3);
  border-top: 1px solid rgba(150, 150, 150, .3);
  text-decoration: none;
  white-space: nowrap;
}
.nice-button.btn-sm { padding: 10px 18px; font-size: .9rem; }
.nice-button.btn-md { padding: 14px 28px; font-size: 1.15rem; }
.nice-button.btn-lg { padding: 18px 40px; font-size: 1.3rem; }
.nice-button:hover {
  background:
    radial-gradient(ellipse at center, rgba(var(--ambient-rgb), calc(.40 * var(--glow, 1))) 0%, rgba(var(--ambient-rgb), calc(.30 * var(--glow, 1))) 40%, rgba(var(--ambient-rgb), calc(.15 * var(--glow, 1))) 70%, transparent 100%),
    #363636;
  box-shadow: 0 4px 8px rgba(0, 0, 0, .4);
  transform: translateY(-1px);
}
.nice-button:active {
  background:
    radial-gradient(ellipse at center, rgba(var(--ambient-rgb), calc(.40 * var(--glow, 1))) 0%, rgba(var(--ambient-rgb), calc(.30 * var(--glow, 1))) 40%, rgba(var(--ambient-rgb), calc(.10 * var(--glow, 1))) 70%, transparent 100%),
    #1e1e1e;
  transform: translateY(0);
  box-shadow: 0 1px 2px rgba(0, 0, 0, .3);
}
.nice-button:disabled, .nice-button.is-disabled { opacity: .5; cursor: not-allowed; transform: none; pointer-events: none; }
.nice-button:focus { outline: 2px solid #4a90e2; outline-offset: 2px; }
.nice-button:focus:not(:focus-visible) { outline: none; }
.nice-button.gradient { background: radial-gradient(ellipse at center, rgba(255, 255, 255, .22), transparent 70%), var(--gradient-ultimate); color: #fff; } /* MIZTWEAKZ-only Ultimate Bundle variant */
.nice-button.grey {
  background: rgba(100, 100, 100, .3);
  border: 1px solid rgba(255, 255, 255, .1);
  box-shadow: inset 0 1px rgba(255, 255, 255, .1);
}
.nice-button.grey:hover { background: rgba(120, 120, 120, .4); transform: translateY(-1px); }
.nice-button.grey:active { background: rgba(80, 80, 80, .4); transform: translateY(0); }
.nice-button.dark { /* alias: the base .nice-button now *is* Paragon's dark tinted button */ }
.nice-button .icon { width: 1.1em; height: 1.1em; }

.btn-clear {
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
  padding: 10px 20px;
  background-color: rgba(70, 70, 70, .2);
  border: 1px solid rgba(126, 126, 126, .3);
  border-radius: 15px;
  color: #fff;
  font-family: var(--font-display); font-size: 1em; font-weight: 400;
  line-height: 1; text-align: center;
  cursor: pointer;
  transition: background-color .2s ease, border-color .2s ease;
}
.btn-clear > span { display: flex; align-items: center; line-height: 1; margin-top: -2px; }
.btn-clear:hover { background-color: rgba(121, 121, 121, .2); border: 1px solid rgba(189, 189, 189, .3); }
.btn-clear__arrow {
  display: flex; align-items: center; justify-content: center; flex: none;
  width: 20px; height: 20px; padding: 3px; border-radius: 50%;
  background-color: #fff; color: #000;
  margin-top: 0;
}
.btn-clear__arrow .icon { width: 11px; height: 11px; margin-top: -1px; }
.btn-clear.discord { color: var(--discord); background-color: rgba(66, 150, 254, .1); border: 1px solid rgba(66, 150, 254, .2); gap: 15px; }
.btn-clear.discord:hover { background-color: rgba(66, 150, 254, .2); border: 1px solid rgba(66, 150, 254, .35); }
.btn-clear.primary { color: var(--accent); background-color: transparent; border: 2px solid var(--accent); }
.btn-clear.primary:hover { background-color: var(--accent); color: #fff; }
.btn-clear.primary:hover .btn-clear__arrow { background-color: #fff; color: var(--accent); }
.btn-clear.cancel { color: #fff; background-color: transparent; border: 2px solid #808080; }
.btn-clear.cancel:hover { background-color: gray; }
.btn-clear.sm { padding: 9px 12px; font-size: .9em; }
.btn-clear.full { width: 100%; }

.social-btn {
  display: inline-flex; align-items: center; justify-content: center;
  width: 40px; height: 40px;
  background: rgba(255, 255, 255, .04);
  border: 1px solid rgba(255, 255, 255, .08);
  border-radius: var(--radius-sm);
  color: rgba(255, 255, 255, .6);
  padding: 0; text-decoration: none; cursor: pointer;
  transition: all .3s ease;
}
.social-btn .icon { width: 18px; height: 18px; }
.social-btn:hover { background: rgba(255, 255, 255, .1); border-color: rgba(255, 255, 255, .2); transform: translateY(-2px); color: #fff; }

/* Paragon .title-tag: padding 2px 5px, radius 10px, colour-mixed in hsl, font inherited (display face, 400, parent size) */
.title-tag {
  --color: var(--accent);
  display: inline-flex; align-items: center; gap: 6px;
  padding: 2px 5px;
  border-radius: 10px;
  color: var(--color);
  background-color: color-mix(in hsl, var(--color) 10%, transparent);
  border: 1px solid color-mix(in hsl, var(--color) 30%, transparent);
  font-family: var(--font-display); font-weight: 400; font-size: 1em;
  white-space: nowrap;
  text-decoration: none;
}
.title-tag--large { font-size: 1.7em; padding: 6px 10px 4px; line-height: 110%; }
.title-tag--gradient { color: #fff; background: linear-gradient(90deg, rgba(var(--ambient-rgb), calc(.12 * var(--glow, 1))), rgba(var(--ambient-rgb), calc(.12 * var(--glow, 1)))); border-color: rgba(var(--ambient-rgb), calc(.35 * var(--glow, 1))); }
.title-tag--gradient > span { background: var(--gradient-ultimate); -webkit-background-clip: text; background-clip: text; color: transparent; }
.nav-tag { cursor: pointer; transition: transform .2s ease, background-color .2s ease, border-color .2s ease; }
.nav-tag:hover { transform: translateY(-2px) scale(1.05); background-color: color-mix(in hsl, var(--color) 20%, transparent); border-color: color-mix(in hsl, var(--color) 50%, transparent); }

/* Paragon .promo-link (PTU promo) and FAQ .cta-link */
.promo-link {
  display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; width: fit-content;
  color: var(--accent-bright);
  font-family: var(--font-body); font-weight: 500; font-size: .95rem;
  transition: gap .2s ease;
}
.promo-link .icon { width: 16px; height: 16px; transition: transform .2s ease; }
.promo-link:hover { gap: 12px; }
.promo-link:hover .icon { transform: translateX(2px); }
.cta-link {
  display: inline-flex; align-items: center; gap: .5rem;
  color: var(--accent);
  font-weight: 600;
  transition: all .3s ease;
}
.cta-link .icon { width: 16px; height: 16px; }
.cta-link:hover { color: var(--accent-bright); gap: .75rem; }

/* ---------- 7. CARDS & CHIPS ---------- */
.glass-card {
  position: relative;
  background: var(--glass);
  -webkit-backdrop-filter: blur(var(--glass-blur));
  backdrop-filter: blur(var(--glass-blur));
  border-radius: var(--radius-xl);
  border-top: 1px solid var(--hairline);
  border-bottom: 1px solid var(--hairline);
}
.glass-card--hover { transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease; }
.glass-card--hover:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--color, var(--accent)) 35%, transparent); box-shadow: 0 20px 40px rgba(0, 0, 0, .35); }
.glass-card--pad { padding: 1.5rem; }

/* Pack / product card (Paragon ProductCard) */
.pack-card-wrapper { --color: var(--accent); position: relative; height: 100%; padding-top: 14px; }
.pack-card {
  display: flex; flex-direction: column; height: 100%;
  max-width: min(413px, 92dvw); margin: 0 auto; width: 100%;
}
.card-tag {
  position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  z-index: 2;
  padding: 4px 12px 18px; border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--color) 25%, #1f1f21);
  color: var(--color);
  font-family: var(--font-body); font-size: .75em; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  white-space: nowrap;
}
.card-tag--gradient { color: var(--accent-ink); background: var(--gradient-ultimate); }
.top-card-container { padding: 3.5px; position: relative; z-index: 1; }
.top-card {
  position: relative; overflow: hidden;
  border-radius: var(--radius-lg);
  aspect-ratio: 16 / 10;
  background:
    radial-gradient(ellipse at 50% 110%, rgba(var(--ambient-rgb), calc(.28 * var(--glow, 1))), transparent 70%),
    linear-gradient(180deg, #2a2a2f, #171719);
  display: flex; align-items: center; justify-content: center;
}
.top-card picture { display: contents; }
.top-card::before {
  content: ""; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: clamp(80px, 40%, 200px); height: 4px;
  border-radius: 0 0 12px 12px;
  background: var(--color);
  box-shadow: 0 0 10px var(--color);
}
.top-card--gradient::before { background: var(--gradient-ultimate); box-shadow: 0 0 12px rgba(var(--ambient-rgb), calc(.6 * var(--glow, 1))); }
/* real box art (2:3, light background) framed whole — a product box on a dark shelf, never stretched or cropped */
.top-card img { height: 84%; width: auto; max-width: 70%; object-fit: contain; border-radius: 8px; box-shadow: 0 18px 30px rgba(0, 0, 0, .55); transition: transform .4s ease; }
.pack-card:hover .top-card img { transform: translateY(-2%) scale(1.03); }
.top-card-text { position: absolute; left: 7%; top: 12%; font-size: 1.6em; font-weight: 600; color: #fff; text-shadow: 0 2px 8px rgba(0, 0, 0, .6); }
.content-wrapper { display: flex; flex-direction: column; gap: 22px; padding: 26px 26px 30px; flex: 1; }
.price-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.price { font-family: var(--font-display); font-size: 2.4rem; font-weight: 400; line-height: 35px; color: #fff; }
.price-currency { font-family: var(--font-body); font-size: .9rem; color: var(--muted); margin-left: 6px; font-weight: 400; }
.original-price { font-family: var(--font-display); font-size: 1.4rem; color: var(--muted); text-decoration: line-through; }
.sale-badge {
  padding: 3px 8px; border-radius: 6px;
  font-family: var(--font-body); font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
  color: var(--accent-2);
  background: rgba(var(--ambient-rgb), calc(.12 * var(--glow, 1)));
  border: 1px solid rgba(var(--ambient-rgb), calc(.4 * var(--glow, 1)));
  animation: mz-sale-pulse 2s ease-in-out infinite;
  align-self: center;
}
.description { color: var(--muted); font-size: 15px; line-height: 1.6; }
.card-disclaimer {
  display: flex; gap: 10px; align-items: flex-start;
  padding: 10px 12px; border-radius: var(--radius-sm);
  font-size: .8rem; color: var(--text-70);
  background: rgba(var(--ambient-rgb), calc(.10 * var(--glow, 1)));
  border: 1px solid rgba(var(--ambient-rgb), calc(.30 * var(--glow, 1)));
}
.card-disclaimer .icon { color: var(--color); width: 16px; height: 16px; margin-top: 2px; }
.features { display: flex; flex-direction: column; gap: 10px; margin-bottom: 10px; }
.feature-header { font-family: var(--font-display); font-size: 1.2em; font-weight: 400; color: #fff; }
.feature-header--color { color: var(--color); }
.features li { display: flex; flex-direction: row; gap: 5px; align-items: center; color: var(--text); font-size: 15px; }
.features li .icon { width: 16px; height: 16px; color: var(--color); flex: none; }
.features--includes li .icon { color: #4ade80; }
.features--excludes li .icon { color: #f87171; }
.pack-card .btn-clear { margin-top: auto; }
.book-now-box { width: 100%; }

/* featured tier shell (Paragon .outer-glow-container, gold → lime/cyan) */
.outer-glow-container {
  position: relative;
  padding: 5px; border-radius: 26px;
  background: linear-gradient(160deg, rgba(var(--ambient-rgb), calc(.22 * var(--glow, 1))), rgba(var(--ambient-rgb), calc(.22 * var(--glow, 1))));
  box-shadow: 0 0 25px rgba(var(--ambient-rgb), calc(.18 * var(--glow, 1))), 0 0 50px rgba(var(--ambient-rgb), calc(.10 * var(--glow, 1))), inset 0 1px rgba(255, 255, 255, .25);
  height: 100%;
}
.outer-glow-container::before {
  content: ""; position: absolute; top: 0; left: 5%; width: 90%; height: 4px;
  border-radius: 0 0 8px 8px;
  background: var(--gradient-ultimate);
  box-shadow: 0 0 15px 3px rgba(var(--ambient-rgb), calc(.55 * var(--glow, 1)));
}
.outer-glow-container .glass-card { background: rgba(10, 10, 12, .7); }

.glass-info-card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.glass-info-card { padding: 18px; display: flex; flex-direction: column; gap: 8px; min-width: 0; overflow: hidden; }
.glass-info-card .info-accent { position: absolute; left: 0; top: 15%; bottom: 15%; width: 1px; background: var(--color, var(--accent)); box-shadow: 0 0 12px rgba(var(--ambient-rgb), calc(.5 * var(--glow, 1))); pointer-events: none; }
.glass-info-card h4 { position: relative; z-index: 1; font-size: 1rem; line-height: 1.35; display: flex; align-items: center; gap: 8px; }
.glass-info-card h4 .icon { color: var(--color, var(--accent)); width: 18px; height: 18px; }
.glass-info-card p { position: relative; z-index: 1; color: var(--muted); line-height: 1.55; }

.feature-card {
  display: flex; gap: 1rem; align-items: center;
  padding: 1.25rem;
  background: rgba(255, 255, 255, .03);
  border: 1px solid rgba(255, 255, 255, .06);
  border-radius: 16px;
  text-align: left;
}
.feature-card .icon { width: 2.5rem; height: 2.5rem; color: var(--accent); flex: none; }
.feature-card > div { display: flex; flex-direction: column; gap: .25rem; }
.feature-card h3 { font-size: 1.1rem; font-weight: 700; }
.feature-card p { font-size: .9rem; color: rgba(255, 255, 255, .6); }

.stat-chip {
  display: flex; align-items: center; gap: .6rem;
  padding: .6rem 1.1rem;
  background: rgba(255, 255, 255, .04);
  border: 1px solid rgba(255, 255, 255, .08);
  border-radius: 100px;
  transition: all .3s ease;
}
.stat-chip:hover { background: rgba(255, 255, 255, .07); border-color: rgba(var(--ambient-rgb), calc(.3 * var(--glow, 1))); }
.stat-value { font-family: var(--font-display); font-size: 1.1rem; font-weight: 800; color: var(--accent-bright); }
.stat-divider { width: 1px; height: 16px; background: rgba(255, 255, 255, .2); }
.stat-label { font-family: var(--font-body); font-size: .8rem; color: var(--text-50); white-space: nowrap; }

.metrics-row { display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--hairline); }
.metric { display: flex; flex-direction: column; gap: .5rem; }
.metric-value { font-family: var(--font-display); font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 900; color: var(--accent); line-height: 1; }
.metric-label { font-size: .9rem; font-weight: 600; color: #fff; }
.metric-desc { font-size: .8rem; color: var(--text-50); }

.status-badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: .8rem; font-weight: 500; text-transform: capitalize; }
.status-badge--success { color: var(--success); background: rgba(34, 197, 94, .2); }
.status-badge--error { color: var(--error); background: rgba(239, 68, 68, .15); }

/* review card (Paragon TwitterCard role) */
/* geometry = Paragon .tweet-card (padding 1rem / 45px bottom, radius .75rem, 0 4px 6px shadow, min-height 200px); palette stays ours */
.review-card {
  position: relative;
  width: 320px; flex: 0 0 320px; min-height: 200px;
  padding: 1rem 1rem 45px;
  background: rgba(8, 8, 10, .55);
  border: 1px solid rgba(255, 255, 255, .08);
  border-radius: .75rem;
  box-shadow: 0 4px 6px rgba(0, 0, 0, .1);
  display: flex; flex-direction: column; gap: .6rem;
  transition: border-color .3s ease, transform .3s ease;
}
.review-card:hover { border-color: rgba(var(--ambient-rgb), calc(.3 * var(--glow, 1))); }
.review-head { display: flex; flex-direction: row; align-items: center; gap: 10px; }
.review-avatar { width: 45px; height: 45px; border-radius: 50%; flex: none; display: grid; place-items: center; background: linear-gradient(135deg, #34343b, #1c1c20); border: 2px solid rgba(255, 255, 255, .12); font-family: var(--font-display); font-weight: 700; color: #f8f8f6; font-size: 1rem; overflow: hidden; }
.review-avatar img { width: 100%; height: 100%; }
.review-name { font-weight: 600; color: #fff; display: flex; align-items: center; gap: 6px; line-height: 1.3; }
.review-verified { display: inline-flex; align-items: center; gap: 3px; font-size: .7rem; color: var(--accent-2); font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
.review-verified .icon { width: 12px; height: 12px; }
.review-stars { display: inline-flex; gap: 2px; color: var(--accent); }
.review-stars .icon { width: 14px; height: 14px; }
.review-stars .icon.dim { color: rgba(255, 255, 255, .2); }
.review-title { font-family: var(--font-display); font-weight: 600; font-size: 1rem; color: #fff; }
.review-body { font-size: 15px; color: #d0d0d2; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 5; line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
.review-meta { position: absolute; left: 1rem; right: 1rem; bottom: 15px; font-size: .875rem; line-height: 10px; color: var(--muted); display: flex; justify-content: space-between; gap: .5rem; }
.review-card--static { width: 100%; max-width: 350px; min-height: auto; flex: none; }
.review-card--compact { width: 100%; flex: none; min-height: auto; padding-bottom: 2.4rem; }

/* ---------- 8. HERO ---------- */
.hero {
  position: relative;
  min-height: auto;
  padding: clamp(2rem, 5vw, 4rem);
  padding-top: 56px; /* owner: no blank space above the logo (Paragon uses 210px) */
  display: flex; align-items: flex-start; justify-content: center;
}
.hero-glow {
  position: absolute; top: 20px; left: 50%; transform: translateX(-50%);
  width: min(900px, 100vw); height: 640px; /* never wider than the viewport: mobile Chrome widens the layout viewport for any overflow */
  background: none;
  pointer-events: none; z-index: -1;
}
.hero-inner {
  width: 100%; max-width: 900px;
  display: flex; flex-direction: column; align-items: center; text-align: center;
  gap: clamp(1.5rem, 3vw, 2.5rem);
}
/* mount animation: any [data-mount] element (hero-inner, banners) */
html.js [data-mount] { opacity: 0; transform: translateY(24px); transition: opacity .9s var(--ease-out-expo), transform .9s var(--ease-out-expo); }
html.js [data-mount].loaded { opacity: 1; transform: none; }

/* masthead: the real MIZ TWEAKZ sticker (transparent PNG/WebP, ~30% of the square is halo — the negative
   block margin trims that). Mount: pops from .94 → 1 while the red ambient glow blooms (.transitioning / .final). */
.logo-showcase { position: relative; display: flex; justify-content: center; width: min(360px, 80vw); margin-block: calc(min(360px, 80vw) * -0.11); }
.logo-showcase picture { display: contents; }
.logo-icon {
  width: 100%; height: auto; aspect-ratio: 1; object-fit: contain;
  filter: drop-shadow(0 0 50px rgba(var(--ambient-rgb), calc(.35 * var(--glow, 1))));
  transform: scale(.94);
  transition: opacity .8s ease, transform .8s ease, filter .8s ease;
}
.logo-showcase.transitioning .logo-icon, .logo-showcase.final .logo-icon { transform: none; filter: drop-shadow(0 0 50px rgba(var(--ambient-rgb), calc(.35 * var(--glow, 1)))); }
html:not(.js) .logo-icon { transform: none; }

.hero-announce {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .45rem 1.1rem; border-radius: 100px;
  background: rgba(var(--ambient-rgb), calc(.08 * var(--glow, 1)));
  border: 1px solid rgba(var(--ambient-rgb), calc(.3 * var(--glow, 1)));
  color: var(--accent);
  font-family: var(--font-display); font-weight: 500; font-size: .95rem; letter-spacing: .06em;
  transition: background .2s ease, transform .2s ease;
}
.hero-announce:hover { background: rgba(var(--ambient-rgb), calc(.15 * var(--glow, 1))); transform: translateY(-1px); }
.headline-block { display: flex; flex-direction: column; align-items: center; gap: .75rem; }
.hero-headline { font-size: clamp(2.75rem, 7vw, 5.5rem); font-weight: 900; line-height: 1; letter-spacing: -.02em; }
.hero-headline span { display: block; }
.hero-headline .accent { color: var(--accent); }
.hero-tagline { font-family: var(--font-body); font-size: clamp(.9rem, 1.5vw, 1.1rem); text-transform: uppercase; letter-spacing: .3em; color: var(--text-50); }
.hero-description { font-family: var(--font-body); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.8; color: rgba(255, 255, 255, .65); max-width: 600px; }
.stats-strip { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
.cta-group { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: .5rem; }

@media (max-width: 768px) {
  .hero { padding-top: 50px; }
  .logo-showcase { width: min(260px, 70vw); margin-block: calc(min(260px, 70vw) * -0.11); }
  .stats-strip { gap: .75rem; }
  .stat-chip { padding: .5rem .9rem; }
  .stat-value { font-size: 1rem; }
  .stat-label { font-size: .75rem; }
}
@media (max-width: 480px) {
  .hero { min-height: auto; padding-bottom: 5rem; }
  .cta-group { flex-direction: column; width: 100%; max-width: 280px; }
  .cta-group .nice-button-box, .cta-group .nice-button { width: 100%; }
  .stat-chip { padding: .45rem .75rem; gap: .4rem; }
  .stat-divider { height: 12px; }
}

/* ---------- 9. HOME SECTIONS ---------- */
/* promo (Paragon PTU promo) */
.promo-section { position: relative; width: 100%; max-width: var(--max-content); margin: 0 auto 30px; display: flex; align-items: center; min-height: 420px; }
.promo-image {
  width: 70%; border-radius: 20px; overflow: hidden;
  -webkit-mask-image: linear-gradient(to right, #000 30%, transparent 75%);
  mask-image: linear-gradient(to right, #000 30%, transparent 75%);
}
.promo-image img { width: 100%; height: auto; }
/* --art: a portrait box-art render instead of a wide screenshot */
.promo-image--art { height: 440px; display: flex; align-items: center; padding-left: 6%; background: radial-gradient(ellipse at 30% 50%, rgba(var(--ambient-2-rgb), calc(.16 * var(--glow, 1))), transparent 60%); }
.promo-image--art picture { display: contents; }
.promo-image--art img { width: auto; height: 100%; border-radius: 12px; filter: drop-shadow(0 30px 40px rgba(0, 0, 0, .6)); }
.promo-content { position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: 45%; display: flex; flex-direction: column; gap: .75rem; }
.promo-icon {
  width: 108px; height: 108px; border-radius: 26px;
  display: grid; place-items: center;
  color: var(--accent-2);
  background: rgba(var(--ambient-rgb), calc(.08 * var(--glow, 1)));
  border: 1px solid rgba(var(--ambient-rgb), calc(.25 * var(--glow, 1)));
  filter: drop-shadow(0 0 30px rgba(var(--ambient-rgb), calc(.35 * var(--glow, 1))));
}
.promo-icon .icon { width: 52px; height: 52px; }
.promo-tag { font-size: .7rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--accent-bright); }
.promo-title { font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 700; line-height: 1.2; }
.promo-desc { font-size: 1rem; line-height: 1.7; color: var(--text-50); }
.services-promo { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--hairline); display: flex; flex-direction: column; gap: 8px; }
.services-promo .promo-link { align-self: flex-start; }
.services-title { font-size: 1.2rem; font-weight: 700; }

/* pack overview grid */
.packs-overview { display: flex; flex-direction: column; gap: 2.5rem; width: 100%; max-width: var(--max-content); margin: 0 auto; }
.pack-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; align-items: stretch; }
.pack-grid--3 { grid-template-columns: repeat(3, 1fr); max-width: 1300px; margin: 0 auto; width: 100%; }
.pack-grid--1 { grid-template-columns: minmax(280px, 413px); justify-content: center; }
@media (max-width: 1200px) { .pack-grid--3 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 800px) { .pack-grid--3 { grid-template-columns: 1fr; } }

/* two-column feature / precision sections */
/* Paragon .feature-section / .precision-section: section padding clamp(2rem,5vw,4rem) clamp(1.5rem,4vw,4rem) around a 1400px grid */
.two-col {
  display: grid; grid-template-columns: 1fr 1.2fr; align-items: center;
  gap: clamp(2rem, 5vw, 5rem);
  width: 100%; max-width: var(--max-content); margin: 0 auto;
  padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 4rem);
}
.two-col--text-left { grid-template-columns: 1.2fr 1fr; }
.text-col { display: flex; flex-direction: column; gap: 1rem; }
.media-col { position: relative; display: flex; justify-content: center; align-items: center; }
/* Paragon .video-wrapper: radius 24px, rgba(0,0,0,.3) fill, .08 border, 0 25px 60px .4 shadow. Width stays 620px for our 16:9 clip (Paragon's 400px is for a portrait phone clip) */
.video-wrapper { position: relative; z-index: 1; width: 100%; max-width: 620px; border-radius: 24px; overflow: hidden; background: rgba(0, 0, 0, .3); border: 1px solid rgba(255, 255, 255, .08); box-shadow: 0 25px 60px rgba(0, 0, 0, .4); }
.video-wrapper picture { display: block; }
.video-wrapper img { display: block; width: 100%; height: auto; }
.media-frame { position: relative; z-index: 1; padding: 8px; width: 100%; max-width: 350px; }
.media-frame img { width: 100%; height: auto; border-radius: 8px; }
.media-frame .corner { position: absolute; width: 24px; height: 24px; border: 2px solid var(--accent); }
.media-frame .corner.tl { top: 0; left: 0; border-right: 0; border-bottom: 0; }
.media-frame .corner.tr { top: 0; right: 0; border-left: 0; border-bottom: 0; }
.media-frame .corner.bl { bottom: 0; left: 0; border-right: 0; border-top: 0; }
.media-frame .corner.br { bottom: 0; right: 0; border-left: 0; border-top: 0; }
.feature-cards { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem; }

/* how-it-works style grid (used for "why MIZTWEAKZ") — Paragon .how-it-works padding + 1300px container */
.how-it-works {
  width: 100%; max-width: calc(1300px + 2 * clamp(1.5rem, 4vw, 4rem)); margin: 0 auto;
  padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 4rem); padding-bottom: clamp(1rem, 2vw, 2rem);
  display: flex; flex-direction: column; text-align: center;
}
.how-it-works .section-header { margin-bottom: clamp(2rem, 4vw, 3rem); }
.steps-container { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
.step-card { --delay: 0s; display: flex; flex-direction: column; gap: .5rem; padding: 1.5rem; text-align: left; }
html.js .reveal .step-card { opacity: 0; }
html.js .reveal.visible .step-card { animation: mz-fade-up .6s ease forwards; animation-delay: var(--delay); }
.step-icon { width: 56px; height: 56px; border-radius: 14px; display: grid; place-items: center; color: var(--accent); background: rgba(var(--ambient-rgb), calc(.1 * var(--glow, 1))); border: 1px solid rgba(var(--ambient-rgb), calc(.25 * var(--glow, 1))); }
.step-icon .icon { width: 26px; height: 26px; }
.step-card h3 { font-size: 1.25rem; font-weight: 700; }
.step-card p { font-size: .95rem; color: rgba(255, 255, 255, .6); line-height: 1.6; }
.cta-container { display: flex; flex-direction: column; align-items: center; text-align: center; margin-top: clamp(2rem, 4vw, 3rem); }
.cta-container .nice-button-box { display: inline-flex; }
.cta-note { font-size: .85rem; color: var(--text-50); margin: 1rem 0 0; }

/* social proof (Paragon .social-proof / .proof-content) */
.social-proof { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 4rem); padding-bottom: 0; }
.proof-title { font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 900; line-height: 1.2; }
.proof-subtitle { font-size: clamp(1rem, 1.5vw, 1.2rem); color: rgba(255, 255, 255, .6); max-width: 500px; }
.proof-line { width: 120px; height: 1px; background: linear-gradient(90deg, transparent, var(--accent), transparent); margin: 15px auto 5px; }
.reviews-carousel-group { display: flex; flex-direction: column; gap: 20px; width: 100%; }

/* final CTA */
.final-cta { width: 100%; max-width: 900px; margin: 0 auto; padding: clamp(2rem, 5vw, 3.5rem); display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; overflow: hidden; }
.final-cta .cta-glow { position: absolute; inset: -40% 20% auto; height: 60%; background: radial-gradient(ellipse at center, rgba(var(--ambient-rgb), calc(.29 * var(--glow, 1))), transparent 70%); pointer-events: none; }
.final-cta > * { position: relative; }
.final-cta h2 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; }
.final-cta p { color: var(--text-70); max-width: 560px; font-size: 1.05rem; }

@media (max-width: 1000px) {
  .promo-image { width: 75%; }
  .promo-content { width: 60%; }
  .promo-icon { width: 100px; height: 100px; }
}
@media (max-width: 900px) {
  .two-col, .two-col--text-left { grid-template-columns: 1fr; text-align: center; }
  .two-col .media-col { order: -1; }
  .video-wrapper { max-width: 420px; }
  .media-frame { max-width: 280px; }
  .text-col { align-items: center; }
  .feature-cards { width: 100%; max-width: 400px; margin: 0 auto; }
  .metrics-row { justify-content: center; flex-wrap: wrap; }
  .metric { align-items: center; text-align: center; }
  .steps-container { grid-template-columns: 1fr; max-width: 450px; margin: 0 auto; }
  .step-card { --delay: 0s !important; }
}
@media (max-width: 800px) {
  .promo-section { flex-direction: column; align-items: center; text-align: center; min-height: 0; }
  .promo-image { width: 100%; -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 85%); mask-image: linear-gradient(to bottom, #000 40%, transparent 85%); }
  .promo-content { position: static; transform: none; width: 100%; margin-top: -60px; align-items: center; }
  .promo-image--art { height: auto; justify-content: center; padding: 0; }
  .promo-image--art img { height: auto; max-height: 360px; }
  .promo-icon { width: 90px; height: 90px; }
  .promo-icon .icon { width: 44px; height: 44px; }
  .services-promo { width: 100%; align-items: center; }
}
@media (max-width: 480px) {
  .feature-card { flex-direction: column; align-items: center; text-align: center; }
  .feature-card > div { align-items: center; }
  .metrics-row { gap: 1.5rem; }
  .metric { min-width: 80px; }
  .cta-container .nice-button-box, .cta-container .nice-button { width: 100%; }
}

/* ---------- 10. MARQUEES ---------- */
.brands-section { position: relative; display: flex; flex-direction: column; align-items: center; width: 100%; padding: clamp(2rem, 4vw, 3rem) 0; }
.brands-label { display: block; font-size: .75rem; letter-spacing: .25em; text-transform: uppercase; color: var(--text-50); text-align: center; margin-bottom: 2.75rem; padding: 0 1.5rem; } /* Paragon: label .75rem + header 2rem */
.brands-marquee {
  width: 100%; max-width: var(--max-content); overflow: hidden; padding: 10px 0;
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
}
.brands-track { display: flex; width: max-content; animation: mz-scroll 12s linear infinite; } /* owner: faster (Paragon 30s) */
.brands-set { display: flex; gap: 3rem; padding-right: 3rem; }
.brand-item { flex-shrink: 0; width: 160px; height: 64px; display: flex; align-items: center; justify-content: center; opacity: .92; transition: opacity .3s ease, transform .3s ease; } /* real game marks shown in colour (owner request) */
.brand-item:hover { opacity: 1; transform: scale(1.1); }
.brand-item img { max-width: 100%; max-height: 100%; width: 100%; height: 100%; object-fit: contain; }
@media (max-width: 768px) {
  .brand-item { width: 100px; height: 50px; }
  .brands-set { gap: 2rem; padding-right: 2rem; }
  .brands-marquee { -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 5%, #000 95%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0%, #000 5%, #000 95%, transparent 100%); }
}

.testimonials {
  position: relative; overflow: hidden;
  margin: 0 60px;
  -webkit-mask-image: linear-gradient(90deg, transparent 2%, #000 15%, #000 85%, transparent 98%);
  mask-image: linear-gradient(90deg, transparent 2%, #000 15%, #000 85%, transparent 98%);
}
.testimonial-track { display: inline-flex; gap: 30px; width: max-content; padding: 6px 0; animation: mz-slide var(--marquee-duration, 51s) linear infinite; }
.testimonial-set { display: flex; gap: 30px; }
.static-cards { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 15px; padding: 0 20px; }
@media (max-width: 790px) {
  .testimonials { display: none; }
  .static-cards { display: flex; }
}

@keyframes mz-scroll { to { transform: translateX(-33.333%); } }
@keyframes mz-slide { to { transform: translateX(var(--marquee-distance, -50%)); } }
@keyframes mz-fade-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
@keyframes mz-sale-pulse { 0%, 100% { box-shadow: 0 0 5px rgba(var(--ambient-rgb), calc(.35 * var(--glow, 1))); } 50% { box-shadow: 0 0 15px rgba(var(--ambient-rgb), calc(.6 * var(--glow, 1))); } }
@keyframes pt-notice-rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
@keyframes mz-spin { to { transform: rotate(360deg); } }
.spinner { width: 40px; height: 40px; border-radius: 50%; border: 3px solid rgba(255, 255, 255, .1); border-top-color: var(--spinner-color, var(--accent)); animation: mz-spin .8s linear infinite; }

/* ---------- 11. FAQ ---------- */
/* Paragon .faq-section (padding) > .faq-container (800px) > header / list / cta */
.faq-section { width: 100%; max-width: calc(800px + 2 * clamp(1.5rem, 4vw, 4rem)); margin: 0 auto; padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 4rem); display: flex; flex-direction: column; }
.faq-section .section-header { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
.faq-title { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 900; }
.faq-subtitle { font-size: 1rem; color: rgba(255, 255, 255, .6); }
.faq-list { display: flex; flex-direction: column; gap: .75rem; text-align: left; }
.faq-item { background: rgba(255, 255, 255, .02); border: 1px solid rgba(255, 255, 255, .06); border-radius: 16px; overflow: hidden; transition: all .3s ease; }
.faq-item:hover { background: rgba(255, 255, 255, .04); border-color: rgba(255, 255, 255, .1); }
.faq-item.open { background: rgba(var(--ambient-rgb), calc(.08 * var(--glow, 1))); border-color: rgba(var(--ambient-rgb), calc(.2 * var(--glow, 1))); }
.faq-question {
  width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: 1.25rem 1.5rem; text-align: left;
  font-family: var(--font-display); font-size: 1rem; font-weight: 600; line-height: 1.4; color: #fff;
  background: transparent; border: none; cursor: pointer;
}
.faq-icon { flex-shrink: 0; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, .05); color: var(--accent); transition: all .3s ease; }
.faq-icon .icon { width: 16px; height: 16px; transition: transform .3s ease; }
.faq-item.open .faq-icon { background: var(--accent); color: #fff; }
.faq-item.open .faq-icon .icon { transform: rotate(45deg) translateY(-1px); }
.faq-answer { max-height: 0; overflow: hidden; transition: max-height .4s ease; }
.faq-answer-inner { padding: 0 1.5rem 1.25rem; font-family: var(--font-body); font-size: .95rem; line-height: 1.7; color: var(--text-70); }
.faq-answer-inner a { color: var(--accent); text-decoration: underline; }
.faq-cta { display: flex; flex-direction: column; align-items: center; text-align: center; margin-top: 3rem; padding: 2rem; background: rgba(255, 255, 255, .02); border: 1px solid rgba(255, 255, 255, .06); border-radius: 16px; }
.faq-cta .cta-text { font-size: .95rem; color: rgba(255, 255, 255, .6); margin: 0 0 1rem; }
@media (max-width: 640px) {
  .faq-question { padding: 1rem 1.25rem; font-size: .95rem; }
  .faq-answer-inner { font-size: .9rem; padding: 0 1.25rem 1rem; }
}

/* ---------- 12. FOOTER ---------- */
/* Paragon Footer.vue verbatim (grid 1.5fr 1fr 1fr 1.2fr, 50px logo, 1.25rem column gap, .75rem link gap) */
.footer { position: relative; margin-top: clamp(4rem, 8vw, 8rem); background: transparent; border-top: 1px solid var(--hairline-soft); overflow: hidden; }
.footer-glow { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 600px; height: 1px; background: linear-gradient(90deg, transparent, rgba(var(--ambient-rgb), calc(.7 * var(--glow, 1))), transparent); opacity: .6; }
.footer-content {
  max-width: var(--max-content); margin: 0 auto;
  display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.2fr; gap: 3rem;
  padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 4vw, 4rem);
}
.footer-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
.brand-link { display: inline-block; width: fit-content; }
.brand-logo { height: 50px; width: auto; filter: drop-shadow(0 0 30px rgba(var(--ambient-rgb), calc(.48 * var(--glow, 1)))); transition: filter .3s ease; }
.brand-link:hover .brand-logo { filter: drop-shadow(0 0 40px rgba(var(--ambient-rgb), calc(.8 * var(--glow, 1)))); }
.brand-tagline { font-family: var(--font-body); color: var(--text-50); font-size: .95rem; line-height: 1.6; margin: 0; max-width: 280px; }
.social-links { display: flex; gap: .75rem; margin-top: .5rem; }
.footer-nav-col { display: flex; flex-direction: column; gap: 1.25rem; }
.nav-title { font-family: var(--font-display); font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .15em; color: rgba(255, 255, 255, .4); margin: 0; }
.footer-nav { display: flex; flex-direction: column; gap: .75rem; }
.nav-link { position: relative; width: fit-content; font-family: var(--font-body); color: var(--text-70); font-size: .95rem; transition: all .2s ease; text-align: left; cursor: pointer; }
.nav-link::after { content: ""; position: absolute; left: 0; bottom: -2px; height: 1px; width: 0; background: var(--accent); transition: width .3s ease; }
.nav-link:hover { color: #fff; }
.nav-link:hover::after { width: 100%; }
.footer-cta { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; height: fit-content; }
.footer-cta .cta-text { font-family: var(--font-body); color: var(--text-50); font-size: .9rem; line-height: 1.5; margin: 0; }
.footer-bottom { border-top: 1px solid var(--hairline-soft); background: transparent; }
.bottom-content { max-width: var(--max-content); margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 1.5rem clamp(1.5rem, 4vw, 4rem); background: transparent; }
.bottom-text { display: flex; flex-direction: column; gap: .35rem; }
.copyright { font-family: var(--font-body); color: rgba(255, 255, 255, .35); font-size: .85rem; margin: 0; }
.disclosure { font-family: var(--font-body); color: rgba(255, 255, 255, .55); font-size: .8rem; line-height: 1.5; max-width: 720px; } /* MIZTWEAKZ-only line */
.accent-bar { width: 60px; height: 3px; border-radius: 2px; background: linear-gradient(90deg, var(--accent), transparent); }
@media (max-width: 1024px) {
  .footer-content { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  .footer-brand { grid-column: 1 / -1; }
  .footer-cta { grid-column: 1 / -1; flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .footer-cta .nav-title, .footer-cta .cta-text { margin: 0; }
}
@media (max-width: 640px) {
  .footer-content { grid-template-columns: 1fr; gap: 2rem; }
  .footer-nav { gap: .25rem; }
  .nav-link { padding: 10px 0; min-width: 44px; } /* 44px touch target for stacked footer links */
  .nav-link::after { bottom: 8px; }
  .footer-cta { flex-direction: column; align-items: flex-start; }
  .footer-cta .nice-button-box, .footer-cta .nice-button { width: 100%; }
  .bottom-content { flex-direction: column; gap: 1rem; text-align: center; }
  .accent-bar { width: 40px; }
}

/* ---------- 13. MODALS ---------- */
/* Paragon Modal.vue verbatim: .5 backdrop + blur(3px) brightness(1.2); panel rgba(10,10,10,.4) blur(1px), 20px radius, .2 border, 0 5px side margin */
.modal-backdrop {
  position: fixed; inset: 0; z-index: var(--z-modal);
  display: flex; align-items: center; justify-content: center;
  background: rgba(0, 0, 0, .5);
  -webkit-backdrop-filter: blur(3px) brightness(1.2);
  backdrop-filter: blur(3px) brightness(1.2);
  opacity: 0; transition: opacity .25s ease;
}
.modal-backdrop[hidden] { display: none; }
.modal-backdrop.is-open { opacity: 1; }
.modal-content {
  --color: var(--accent);
  position: relative;
  width: auto; max-width: var(--max-width, 1200px); max-height: 90vh;
  margin: 0 5px; padding: 0;
  display: flex; flex-direction: column;
  color: #fff;
  background: rgba(10, 10, 10, .4);
  -webkit-backdrop-filter: blur(1px);
  backdrop-filter: blur(1px);
  border: 1px solid rgba(255, 255, 255, .2);
  border-radius: 20px;
  opacity: 0; transform: scale(.8) translateY(-20px);
  transition: transform .3s ease, opacity .3s ease;
  overflow: hidden;
}
.modal-backdrop.is-open .modal-content { opacity: 1; transform: scale(1) translateY(0); }
.modal-content--colored::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; z-index: 1;
  box-shadow: inset 0 -20px 30px color-mix(in hsl, var(--color) 10%, transparent), inset 0 -40px 60px color-mix(in hsl, var(--color) 10%, transparent);
  -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 100%); -webkit-mask-repeat: no-repeat; -webkit-mask-size: 100% 100%;
  mask-image: linear-gradient(to top, #000 20%, transparent); mask-repeat: no-repeat; mask-size: 100% 100%;
}
.modal-top-bar { position: relative; z-index: 2; flex-shrink: 0; width: 100%; color: #fff; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 30px 30px 0; margin-bottom: 20px; }
.modal-top-bar .title-tag--large { font-size: 1.7em; padding: 6px 10px 4px; line-height: 110%; }
.modal-close { margin-left: auto; padding: 0; background: transparent; border: 0; color: inherit; font: inherit; font-size: 2em; font-weight: lighter; line-height: 1; cursor: pointer; user-select: none; }
.modal-close:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
.modal-body {
  position: relative; z-index: 2; flex: 1 1 auto; min-height: 0;
  padding: 0 30px 30px; overflow-y: auto; overflow-x: hidden;
  display: flex; flex-direction: column; gap: 1.25rem; /* our modal bodies space their blocks with this gap (Paragon's inner components carry margins) */
  scrollbar-width: thin; scrollbar-color: rgba(255, 255, 255, .2) transparent;
  -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 calc(100% - 20px), transparent 100%);
  mask-image: linear-gradient(180deg, #000 0%, #000 calc(100% - 20px), transparent 100%);
}
.modal-body.is-scrolled { -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 20px, #000 calc(100% - 20px), transparent 100%); mask-image: linear-gradient(180deg, transparent 0, #000 20px, #000 calc(100% - 20px), transparent 100%); }
.modal-body::-webkit-scrollbar { width: 6px; background: transparent; }
.modal-body::-webkit-scrollbar-track { background: transparent; margin: 10px 0; }
.modal-body::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, .2); border-radius: 4px; }
.modal-body::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, .3); }
.modal-footer { position: relative; z-index: 2; flex-shrink: 0; display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 10px; margin-top: 20px; padding: 0 30px 30px; }
.modal-footer:empty { display: none; }
.modal-description { color: var(--text-70); line-height: 1.7; }
.modal-note { display: flex; gap: 10px; align-items: flex-start; font-size: .9rem; color: var(--text-70); padding: 12px 14px; border-radius: var(--radius-sm); background: rgba(255, 255, 255, .03); border: 1px solid var(--hairline-soft); }
.modal-note .icon { color: var(--color); width: 18px; height: 18px; flex: none; margin-top: 2px; }
.modal-note--warn .icon { color: #fdba74; }
.modal-section { display: flex; flex-direction: column; gap: .75rem; }
.modal-reviews { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
.buy-layout { display: grid; grid-template-columns: 220px 1fr; gap: 1.75rem; align-items: start; }
.buy-art { border-radius: var(--radius-lg); overflow: hidden; background: radial-gradient(ellipse at 50% 100%, rgba(var(--ambient-rgb), calc(.25 * var(--glow, 1))), transparent 70%), #17171a; border: 1px solid var(--hairline); }
.buy-art picture { display: block; }
.buy-art img { display: block; width: 100%; height: auto; }
.buy-details { display: flex; flex-direction: column; gap: 1rem; }
.rating-summary { display: flex; align-items: center; gap: .6rem; font-size: .9rem; color: var(--text-70); }
.login-screen { max-width: 340px; margin: 0 auto; padding: .5rem 0 1rem; display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; font-weight: 600; color: #fff; }
.login-screen .login-icon { width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; color: var(--discord); background: rgba(66, 150, 254, .12); border: 1px solid rgba(66, 150, 254, .3); }
.login-screen .login-icon .icon { width: 30px; height: 30px; }
.login-screen small { font-weight: 400; color: var(--text-50); font-size: .85rem; }
@media (max-width: 768px) {
  .modal-content { max-height: calc(100dvh - 40px); }
  .modal-top-bar { padding: 20px 20px 0; margin-bottom: 15px; }
  .modal-body { padding: 0 20px 20px; }
  .modal-footer { padding: 0 20px 20px; }
  .modal-top-bar .title-tag--large { font-size: 1.3em; }
}
@media (max-width: 600px) {
  .modal-footer { flex-direction: column; align-items: stretch; }
  .modal-footer > * { width: 100%; }
  .modal-footer .nice-button-box, .modal-footer .nice-button, .modal-footer .btn-clear { width: 100%; }
  .glass-info-card-grid { grid-template-columns: 1fr; }
  .buy-layout { grid-template-columns: 1fr; }
  .buy-art { max-width: 200px; margin: 0 auto; }
}

/* consent preferences (inside modal) — Paragon ConsentPreferencesModal geometry */
.pt-prefs-intro { color: var(--text-70); font-size: .95rem; line-height: 1.6; font-family: var(--font-body); }
.pt-prefs-group { border: 1px solid rgba(255, 255, 255, .12); border-radius: 12px; background: rgba(255, 255, 255, .03); font-family: var(--font-body); }
.pt-prefs-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; }
.pt-prefs-head h3 { font-size: 1.05rem; }
.pt-prefs-always { color: var(--accent); text-transform: uppercase; font-size: .8rem; letter-spacing: .05em; white-space: nowrap; }
.pt-prefs-desc { font-size: .9rem; color: var(--text-70); margin: 0; padding: 0 16px 16px; }
.pt-switch { position: relative; display: inline-flex; width: 42px; height: 24px; flex-shrink: 0; }
.pt-switch input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.pt-prefs-slider { position: absolute; inset: 0; border-radius: 24px; background: rgba(255, 255, 255, .15); transition: background .2s ease; pointer-events: none; }
.pt-prefs-slider::before { content: ""; position: absolute; left: 3px; top: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: transform .2s ease; }
.pt-switch input:checked + .pt-prefs-slider { background: var(--accent); }
.pt-switch input:checked + .pt-prefs-slider::before { transform: translateX(18px); }
.pt-switch input:disabled + .pt-prefs-slider { opacity: .55; }
.pt-switch input:focus-visible + .pt-prefs-slider { outline: 2px solid #fff; outline-offset: 2px; }

/* ---------- 14. COOKIE CONSENT (Paragon ConsentNotice.vue) ---------- */
.pt-notice {
  position: fixed; right: 20px; bottom: 20px; z-index: var(--z-notice);
  width: min(460px, calc(100vw - 40px));
  padding: 20px;
  color: #fff;
  background-color: rgba(10, 10, 10, .85);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  animation: pt-notice-rise .3s ease;
}
.pt-notice[hidden] { display: none; }
.pt-notice h2 { font-size: 1.1rem; margin: 0 0 8px; }
.pt-notice p { font-family: var(--font-body); font-size: .9rem; line-height: 1.5; color: rgba(255, 255, 255, .75); margin: 0 0 16px; }
.pt-notice-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; }
.pt-notice-actions > * { flex: 1 1 auto; }
.pt-notice-actions .nice-button { width: 100%; }
@media (max-width: 640px) {
  .pt-notice { left: 0; right: 0; bottom: 0; width: 100%; border-radius: 22px 22px 0 0; }
}
.pt-prefs-revisit {
  position: fixed; left: 16px; bottom: 16px; z-index: var(--z-revisit);
  width: 42px; height: 42px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(10, 10, 10, .7);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255, 255, 255, .2);
  color: rgba(255, 255, 255, .75);
  font-size: 1rem; cursor: pointer;
  transition: color .2s ease, border-color .2s ease, transform .2s ease;
}
.pt-prefs-revisit .icon { width: 16px; height: 16px; }
.pt-prefs-revisit:hover { color: #fff; border-color: rgba(255, 255, 255, .4); transform: translateY(-1px); }
.pt-prefs-revisit:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
.pt-prefs-revisit[hidden] { display: none; }

/* ---------- 15. BANNER, FORMS, 404 (shared with Phase B pages) ---------- */
.banner {
  position: relative; isolation: isolate; overflow: hidden;
  width: 100%; max-width: 95dvw; min-height: 260px; margin: 0 auto;
  border-radius: 24px;
  display: flex; align-items: center; justify-content: center; text-align: center;
  background:
    repeating-linear-gradient(90deg, rgba(255, 255, 255, .025) 0 1px, transparent 1px 42px),
    linear-gradient(180deg, #2a2a2f, #15151a);
  border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline);
  user-select: none;
}
.banner::before {
  content: ""; position: absolute; inset: 0; z-index: -1;
  background:
    radial-gradient(ellipse at 100% 50%, rgba(var(--ambient-rgb), calc(.35 * var(--glow, 1))), transparent 55%),
    radial-gradient(ellipse at 0% 0%, rgba(var(--ambient-2-rgb), calc(.19 * var(--glow, 1))), transparent 50%),
    radial-gradient(ellipse at 0% 100%, rgba(var(--ambient-rgb), calc(.16 * var(--glow, 1))), transparent 50%);
}
.banner-content { display: flex; flex-direction: column; align-items: center; gap: 20px; padding: clamp(2rem, 5vw, 3.5rem) 1.5rem; }
.banner-title { font-size: 4.5rem; line-height: 70px; font-weight: 500; }
.banner-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
.banner-subtitle { color: var(--text-70); max-width: 640px; }
@media (max-width: 1415px) { .banner-pills .title-tag { min-height: 40px; } } /* touch-size the pill links below the desktop-nav breakpoint */
@media (max-width: 630px) { .banner-title { font-size: 3.5rem; line-height: 56px; } }

.section-with-bar { position: relative; width: 100%; display: flex; justify-content: center; flex-direction: column; }
.section-with-bar h2:where(:not(.section-title)) { font-size: 2em; font-weight: 400; margin: .67em 0; }
@media (min-width: 1620px) { .section-with-bar h1, .section-with-bar h2:where(:not(.section-title)) { margin-top: -6px; } }

/* Paragon .form-* verbatim (focus = .3 white border, no ring; textarea 80px). The 6px label gap is ours: Paragon's form layout lives in a lazy chunk we don't have */
.form-label { display: block; text-align: left; font-size: .95rem; color: rgba(255, 255, 255, .9); margin-bottom: 6px; }
.form-input, .form-textarea, .form-select {
  width: 100%; padding: 12px 14px;
  border: 1px solid rgba(255, 255, 255, .15); border-radius: 10px;
  background: rgba(30, 30, 30, .6); color: #fff; font-family: inherit; font-size: 1rem;
  transition: border-color .2s ease, background-color .2s ease;
}
.form-input::placeholder, .form-textarea::placeholder { color: rgba(255, 255, 255, .4); }
.form-input:focus, .form-textarea:focus, .form-select:focus { outline: none; border-color: rgba(255, 255, 255, .3); background: rgba(40, 40, 40, .6); }
.form-textarea { min-height: 80px; resize: vertical; }
.form-note { font-size: .85rem; color: var(--text-50); display: flex; gap: 8px; align-items: center; }
.status-message { padding: 12px 14px; border-radius: var(--radius-md); font-size: .9rem; }
.status-message--success { color: #10b981; background: rgba(16, 185, 129, .15); }
.status-message--error { color: var(--error); background: rgba(239, 68, 68, .15); }

.not-found { min-height: calc(100dvh - 300px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 50px; text-align: center; }
.not-found-heading { color: var(--accent); font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 700; }

/* ---------- 16. MOTION & A11Y ---------- */
/* scroll reveal: .animate → .slide-up (threshold .01) · .reveal → .visible (threshold .2) */
html.js .animate { opacity: 0; transform: translateY(30px); transition: opacity .6s ease-out, transform .6s ease-out; }
html.js .animate.slide-up { opacity: 1; transform: none; }
html.js .reveal { opacity: 0; transform: translateY(40px); transition: opacity .8s ease, transform .8s ease; }
html.js .reveal.visible { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
  html.js .animate, html.js .reveal, html.js [data-mount], html.js .reveal .step-card { opacity: 1 !important; transform: none !important; animation: none !important; }
  .brands-track, .testimonial-track { animation: none !important; }
  .logo-icon { transform: none !important; }
  .sale-badge { animation: none !important; }
}

/* Results-section comparison clip (owner-supplied video, 2026-09-05). Fills the media slot like the image it replaced. */
.video-wrapper video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: inherit; background: #000; }

/* ---------- 17. MOBILE PASS (2026-09-05) ----------
   Additive phone-only rules; every desktop value above stays Paragon-exact.
   Breakpoints reuse Paragon's own (768 / 640 / 480). */
@media (max-width: 768px) {
  body { font-size: 16px; }                                        /* 16px body copy on phones (Paragon's 15px stays on desktop) */
  .description, .features li, .review-body { font-size: 16px; }
  .review-verified, .sale-badge, .new-badge { font-size: .75rem; } /* nothing renders below 12px */
  .btn-clear { min-height: 44px; }                                 /* Paragon's 10px 20px pill is 40px tall at 1em; 44px touch target */
  .cta-link, .promo-link { min-height: 44px; }                     /* inline-flex text links get a 44px hit area */
  .banner-pills .title-tag { min-height: 44px; }
  .modal-close { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; margin: -7px -12px -7px auto; } /* bare 2em "x" → 44px target, same visual position */
  .modal-footer .nice-button.btn-sm { padding: 13px 18px; }          /* consent-preferences buttons: 38px → 44px */
  .pt-switch input { inset: -10px -8px; width: auto; height: auto; }  /* invisible input = the hit area: 42×24 toggle gets a 58×44 target */
}
@media (max-width: 640px) {
  /* cookie card: two-up buttons + full-width Accept so the card takes ~250px instead of ~380px of the viewport */
  .pt-notice-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .pt-notice-actions [data-consent="accept"] { grid-column: 1 / -1; }
  .pt-notice-actions .nice-button { padding: 12px 16px; font-size: 1rem; }
}
@media (max-width: 480px) {
  /* hero: drop the section's side padding (the page already has 20px) so each headline sentence fits on one line
     at 320–480px instead of breaking into four lines with orphaned "FPS." / "Delay." */
  .hero { padding-left: 0; padding-right: 0; }
  .hero-headline { font-size: clamp(1.75rem, 9.6vw, 2.25rem); }
  .hero-headline span { text-wrap: balance; }
  .hero-announce { min-height: 44px; font-size: .875rem; letter-spacing: .04em; line-height: 1.35; text-align: center; padding: .5rem 1rem; }
}

/* ---------- owner revisions 2026-09-05 (late): wide results clip, creators grid, review header ---------- */
@media (min-width: 901px) {
  .two-col--media-wide { grid-template-columns: 1.7fr 1fr; }
  .two-col--media-wide .video-wrapper { max-width: 980px; }
}
.creators-section { text-align: center; }
.creators-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; width: 100%; max-width: 1100px; margin: 2rem auto 2.5rem; }
.creator-card { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; padding: 2rem 1.5rem; }
.creator-avatar { width: min(220px, 60vw); height: auto; aspect-ratio: 1; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 4px rgba(255, 255, 255, .06), 0 20px 50px rgba(0, 0, 0, .45); }
.creator-name { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--heading); margin: 0; }
.creators-section .cta-group { justify-content: center; }
@media (max-width: 900px) { .creators-grid { grid-template-columns: 1fr; max-width: 420px; } }
.proof-stars { font-size: 1.75rem; line-height: 1; letter-spacing: .1em; color: #f8ff00; margin: .5rem 0 .25rem; } /* the store's Judge.me star yellow */
.proof-verified { display: inline-flex; align-items: center; gap: .4rem; margin: 0; color: var(--text); font-weight: 500; }
.proof-verified .icon { width: 18px; height: 18px; color: #22c9b8; } /* teal "verified" check like the store */

/* vibrance pass (owner request 2026-09-06): richer media and punchier accent tints */
.video-wrapper video, .video-wrapper img, .creator-avatar { filter: saturate(1.25) contrast(1.04); }
.brand-item img { filter: saturate(1.2); }
.hero-headline .accent, .text-accent { text-shadow: none; }
.section-label { color: var(--accent-bright); }
.stat-value, .metric-value { color: var(--accent-bright); }
.feature-card .icon, .feature-card > i, .step-icon { color: var(--accent-bright); }

/* ---------- mobile glow tone-down (owner request 2026-09-09): every ambient alpha is multiplied by --glow ---------- */
@media (max-width: 768px) {
  :root { --glow: .45; }
  .hero-glow { opacity: .5; }
  body::before { background-image: url({{ 'texture-mobile.svg' | asset_url }}); }
}


/* ---------- the word "Free" in "Download for Free" (owner request 2026-09-09): green, bold, bright; the button itself stays standard ---------- */
.free-word { color: #5cff8f; font-weight: 800; text-shadow: none; }
.nice-button:hover .free-word { color: #7dffa8; }

/* ---------- "Reduce Input Delay." black outline (owner request 2026-09-09) ---------- */
.hero-headline > span { -webkit-text-stroke: 3px #000; paint-order: stroke fill; text-shadow: 0 0 2px #000; } /* both headline lines outlined (owner request 2026-09-09) */
/* results section: centred column beside the clip (owner request 2026-09-09) */
#results.two-col { align-items: center; justify-items: center; }
#results .text-col { align-items: center; text-align: center; justify-content: center; width: 100%; }
#results .feature-cards { width: 100%; text-align: left; }
/* "Free download" phrase shares the green treatment */
.section-label .free-word { font-size: inherit; }

/* metric captions removed (owner request 2026-09-09) */
.metric-desc { display: none !important; }

/* header: login button removed (owner request 2026-09-09); spacer keeps the tab bar centred */
.nav-spacer { display: block; width: 1px; height: 1px; }



/* no glow on download buttons (owner request 2026-09-10): flat dark face, no inner sheen, no halo; plain drop shadow only */
.nice-button[href*="MizTweakz-Setup"] { background: #2c2c2c !important; box-shadow: 0 2px 4px rgba(0, 0, 0, .35) !important; filter: none !important; text-shadow: none !important; }
.nice-button[href*="MizTweakz-Setup"]:hover { background: #383838 !important; box-shadow: 0 4px 8px rgba(0, 0, 0, .4) !important; filter: none !important; }

/* Free is always green, everywhere it is a label (owner request 2026-09-10) */
.free-word { color: #5cff8f !important; font-weight: 800; text-shadow: none; }
.nice-button:hover .free-word, .free-word:hover { color: #7dffa8 !important; }
